{
  "model": "small + large-v3-turbo verified ranges",
  "segments": [
    {
      "start": 0.08,
      "end": 1.48,
      "text": "嗨 大家好 我是拿言"
    },
    {
      "start": 1.48,
      "end": 3.08,
      "text": "欢迎来到科技美学的直播间"
    },
    {
      "start": 3.08,
      "end": 5.44,
      "text": "今天我们和大家一起观看的就是"
    },
    {
      "start": 5.44,
      "end": 9.24,
      "text": "刚刚发布的中兴AXON全新的旗舰机型"
    },
    {
      "start": 9.24,
      "end": 13.52,
      "text": "我们过去这些年一直期待的就是完美无缺的屏幕"
    },
    {
      "start": 13.52,
      "end": 17.0,
      "text": "但是非常遗憾 因为前置摄像头的存在"
    },
    {
      "start": 17.0,
      "end": 19.72,
      "text": "没有一款完美的屏幕能够打动我"
    },
    {
      "start": 19.72,
      "end": 24.04,
      "text": "而在今年2022年中兴的AXON40系列"
    },
    {
      "start": 24.04,
      "end": 26.96,
      "text": "在屏下摄像头这块是不是变得更完美了呢"
    },
    {
      "start": 26.96,
      "end": 30.4,
      "text": "咱们不废话 抓紧来看 争计的表现"
    },
    {
      "start": 31.68,
      "end": 34.28,
      "text": "OK 中兴的AXON40 Ultra"
    },
    {
      "start": 34.28,
      "end": 36.08,
      "text": "首先我们看一下包装盒里边"
    },
    {
      "start": 36.08,
      "end": 39.32,
      "text": "40在下方是有中兴的标志"
    },
    {
      "start": 40.48,
      "end": 42.76,
      "text": "OK 盒子本身在上面是这种"
    },
    {
      "start": 42.76,
      "end": 45.08,
      "text": "类似磨砂的 亲服材质"
    },
    {
      "start": 45.08,
      "end": 46.6,
      "text": "还是颇有质感的感觉"
    },
    {
      "start": 46.6,
      "end": 49.56,
      "text": "哦 盒子十分的厚实"
    },
    {
      "start": 49.56,
      "end": 52.6,
      "text": "产品本身拿在手里不算特别的重"
    },
    {
      "start": 52.6,
      "end": 54.12,
      "text": "也没有那么压手"
    },
    {
      "start": 55.0,
      "end": 57.2,
      "text": "好了 每个配件都有包装盒"
    },
    {
      "start": 57.2,
      "end": 58.44,
      "text": "咱们逐个打开"
    },
    {
      "start": 58.44,
      "end": 61.56,
      "text": "首先卡针不展示了"
    },
    {
      "start": 61.56,
      "end": 62.4,
      "text": "VIP卡"
    },
    {
      "start": 62.4,
      "end": 64.96,
      "text": "很多同学可能会把包装里面的卡片丢掉"
    },
    {
      "start": 64.96,
      "end": 66.92,
      "text": "劝你在丢掉之前一定要仔细看一看"
    },
    {
      "start": 66.92,
      "end": 68.32,
      "text": "上面会有一些权益"
    },
    {
      "start": 68.32,
      "end": 69.56,
      "text": "纸片不展示了"
    },
    {
      "start": 69.56,
      "end": 71.76,
      "text": "薄壳充电器"
    },
    {
      "start": 71.76,
      "end": 72.8,
      "text": "还算比较小小"
    },
    {
      "start": 72.8,
      "end": 74.92,
      "text": "这边是单独的PD接口"
    },
    {
      "start": 74.92,
      "end": 77.04,
      "text": "80瓦的淡化加充电器"
    },
    {
      "start": 77.04,
      "end": 79.04,
      "text": "C口的好处就是可以通用的"
    },
    {
      "start": 79.04,
      "end": 81.64,
      "text": "线材部分你可以看到还是比较的粗的"
    },
    {
      "start": 81.64,
      "end": 83.4,
      "text": "也有一定的硬度"
    },
    {
      "start": 83.44,
      "end": 86.12,
      "text": "99厘米的双C口数据线"
    },
    {
      "start": 86.12,
      "end": 87.76,
      "text": "包壳这边"
    },
    {
      "start": 87.76,
      "end": 89.36,
      "text": "可以听到内部是凸点"
    },
    {
      "start": 89.36,
      "end": 90.64,
      "text": "外部是光滑"
    },
    {
      "start": 90.64,
      "end": 92.44,
      "text": "接下来就是我们今天的主角"
    },
    {
      "start": 92.44,
      "end": 94.2,
      "text": "中心的Excel 40"
    },
    {
      "start": 94.2,
      "end": 99.01,
      "text": "拿在手里很修长的感觉"
    },
    {
      "start": 99.01,
      "end": 100.97,
      "text": "好 那么整个正面的话"
    },
    {
      "start": 100.97,
      "end": 103.45,
      "text": "是一个双微曲面的表面"
    },
    {
      "start": 103.45,
      "end": 106.45,
      "text": "那么手感部分我们手指握在两侧的时候"
    },
    {
      "start": 106.45,
      "end": 108.01,
      "text": "不论是左边还是右边"
    },
    {
      "start": 108.01,
      "end": 111.53,
      "text": "它整体的触感的前后弧度是统一的"
    },
    {
      "start": 111.53,
      "end": 113.17,
      "text": "这里还真的挺特别在哪呢"
    },
    {
      "start": 113.21,
      "end": 114.97,
      "text": "就是我们之前说到很多的"
    },
    {
      "start": 114.97,
      "end": 116.53,
      "text": "圈屏机型和边框部分"
    },
    {
      "start": 116.53,
      "end": 118.09,
      "text": "可能会有一个小小的接缝"
    },
    {
      "start": 118.09,
      "end": 120.77,
      "text": "拇指划过的时候会有一点点割裂的感觉"
    },
    {
      "start": 120.77,
      "end": 123.09,
      "text": "那么这台机器的话几乎没有"
    },
    {
      "start": 123.09,
      "end": 124.09,
      "text": "看细节的话"
    },
    {
      "start": 124.09,
      "end": 127.09,
      "text": "整个的玻璃和金属边框"
    },
    {
      "start": 127.09,
      "end": 128.65,
      "text": "严丝合缝的在一起"
    },
    {
      "start": 128.65,
      "end": 130.93,
      "text": "来看一下背面撕掉"
    },
    {
      "start": 130.93,
      "end": 131.85,
      "text": "贴膜"
    },
    {
      "start": 131.85,
      "end": 133.17,
      "text": "好 这个背面说实话"
    },
    {
      "start": 133.17,
      "end": 134.25,
      "text": "有点夸张"
    },
    {
      "start": 134.25,
      "end": 136.05,
      "text": "三枚镜头组"
    },
    {
      "start": 136.05,
      "end": 141.09,
      "text": "这次的亮点就是双索尼的MX787传感器"
    },
    {
      "start": 141.13,
      "end": 144.17,
      "text": "三枚镜头组都可以被称作主摄"
    },
    {
      "start": 144.17,
      "end": 146.93,
      "text": "同时有一个潜望镜式的镜头组"
    },
    {
      "start": 146.93,
      "end": 149.77,
      "text": "在镜头组的外圈设计这里面"
    },
    {
      "start": 149.77,
      "end": 151.37,
      "text": "是颇有特色的"
    },
    {
      "start": 151.37,
      "end": 154.13,
      "text": "首先是我们看到这种类似小的接梯状的设计"
    },
    {
      "start": 154.13,
      "end": 156.25,
      "text": "在边框这里是两段式的凸起"
    },
    {
      "start": 156.25,
      "end": 157.21,
      "text": "圈层旁边这里"
    },
    {
      "start": 157.21,
      "end": 159.29,
      "text": "还有一圈小小的切边的装饰"
    },
    {
      "start": 159.29,
      "end": 162.41,
      "text": "在下方这里有一个亮片的金属装饰"
    },
    {
      "start": 162.41,
      "end": 164.37,
      "text": "灯光划过的时候很漂亮"
    },
    {
      "start": 164.37,
      "end": 167.93,
      "text": "同时背板这里用的是这种粗磨纱的材质"
    },
    {
      "start": 167.93,
      "end": 169.53,
      "text": "颇有那种自然的纹理"
    },
    {
      "start": 170.21,
      "end": 171.13,
      "text": "能听到这个声音"
    },
    {
      "start": 171.13,
      "end": 175.25,
      "text": "但其实它是用玻璃的特殊工艺来实现的"
    },
    {
      "start": 175.25,
      "end": 176.09,
      "text": "包括下方"
    },
    {
      "start": 176.09,
      "end": 177.85,
      "text": "我们看到中心的小小的logo"
    },
    {
      "start": 177.85,
      "end": 180.05,
      "text": "所以整个背板这块内圆"
    },
    {
      "start": 180.05,
      "end": 182.33,
      "text": "外方十分的硬朗的设计"
    },
    {
      "start": 182.33,
      "end": 183.37,
      "text": "顶部我们看看这边"
    },
    {
      "start": 183.37,
      "end": 185.01,
      "text": "还有红外线的接口"
    },
    {
      "start": 185.01,
      "end": 186.01,
      "text": "以及顶部的扬声器"
    },
    {
      "start": 186.01,
      "end": 187.21,
      "text": "底部除了扬声器之外"
    },
    {
      "start": 187.21,
      "end": 189.97,
      "text": "这里还有卡针的部分"
    },
    {
      "start": 189.97,
      "end": 191.41,
      "text": "SIM卡槽这边是叠放"
    },
    {
      "start": 191.41,
      "end": 193.81,
      "text": "同时有一次白色的胶圈"
    },
    {
      "start": 193.81,
      "end": 195.05,
      "text": "起到一个防水的作用"
    },
    {
      "start": 195.05,
      "end": 198.69,
      "text": "整机应该说视觉观感上是非常硬朗的"
    },
    {
      "start": 198.69,
      "end": 199.41,
      "text": "毫无疑问"
    },
    {
      "start": 199.41,
      "end": 202.41,
      "text": "它可以很轻松的摆放在桌面上面"
    },
    {
      "start": 202.41,
      "end": 204.05,
      "text": "我的手机能立起来"
    },
    {
      "start": 204.05,
      "end": 206.05,
      "text": "你可以往上方下方金属"
    },
    {
      "start": 206.05,
      "end": 208.53,
      "text": "到中间有一个非常明显的收窄"
    },
    {
      "start": 208.53,
      "end": 210.73,
      "text": "同时在电源键和音量键这里"
    },
    {
      "start": 210.73,
      "end": 212.09,
      "text": "有一个很明显的下沉"
    },
    {
      "start": 212.09,
      "end": 213.85,
      "text": "所以整个机型的设计"
    },
    {
      "start": 213.85,
      "end": 216.21,
      "text": "做到了相当的极致的状态"
    },
    {
      "start": 216.21,
      "end": 216.77,
      "text": "来吧 同伴们"
    },
    {
      "start": 216.77,
      "end": 218.05,
      "text": "在不点亮屏幕的情况下"
    },
    {
      "start": 218.05,
      "end": 221.29,
      "text": "大家给这台AXO 40 Ultra的外观打一个分数"
    },
    {
      "start": 222.29,
      "end": 223.17,
      "text": "那么套包盖之后"
    },
    {
      "start": 223.17,
      "end": 224.85,
      "text": "你会发觉它的颜色部分"
    },
    {
      "start": 224.85,
      "end": 226.45,
      "text": "似乎一下子变成浅灰色"
    },
    {
      "start": 226.45,
      "end": 229.01,
      "text": "整个颜值部分有了很明显的变化"
    },
    {
      "start": 229.09,
      "end": 230.33,
      "text": "接下来我们开机"
    },
    {
      "start": 230.33,
      "end": 231.97,
      "text": "ZT中心的标志"
    },
    {
      "start": 231.97,
      "end": 233.89,
      "text": "MyOS全新的系统"
    },
    {
      "start": 235.33,
      "end": 237.45,
      "text": "哦 一个很漂亮的5G先锋"
    },
    {
      "start": 237.45,
      "end": 238.93,
      "text": "为快不迫 即刻出放"
    },
    {
      "start": 240.01,
      "end": 242.41,
      "text": "不知道大家的第一印象怎么样"
    },
    {
      "start": 242.41,
      "end": 244.57,
      "text": "从我个人的角度来看的话"
    },
    {
      "start": 244.57,
      "end": 247.01,
      "text": "它的两边的边框是比较窄的"
    },
    {
      "start": 247.01,
      "end": 250.01,
      "text": "那么上下部分基本上算是等宽"
    },
    {
      "start": 250.01,
      "end": 252.85,
      "text": "底下可能略宽那么0.5毫米的样子"
    },
    {
      "start": 252.85,
      "end": 255.65,
      "text": "我自己觉得它的平淡比还是很高的"
    },
    {
      "start": 255.65,
      "end": 258.45,
      "text": "额外多出来那么一点平淡比的感觉"
    },
    {
      "start": 258.45,
      "end": 260.65,
      "text": "毫无疑问的就是在这块屏幕上面"
    },
    {
      "start": 260.65,
      "end": 263.05,
      "text": "你看不到挖孔"
    },
    {
      "start": 263.05,
      "end": 264.53,
      "text": "这是最重要的一点"
    },
    {
      "start": 264.53,
      "end": 266.41,
      "text": "从上方往下滑"
    },
    {
      "start": 266.41,
      "end": 268.25,
      "text": "每一个过程你都可以看到"
    },
    {
      "start": 268.25,
      "end": 271.45,
      "text": "它挖孔部分去掉之后的一个整个的影响"
    },
    {
      "start": 271.45,
      "end": 272.61,
      "text": "有没有挖孔"
    },
    {
      "start": 272.61,
      "end": 274.57,
      "text": "颜值的变化真的是太大了"
    },
    {
      "start": 274.57,
      "end": 276.05,
      "text": "好 一会我们来看细节"
    },
    {
      "start": 276.05,
      "end": 276.85,
      "text": "大家不要着急"
    },
    {
      "start": 276.85,
      "end": 278.41,
      "text": "咱们先看整体的观感"
    },
    {
      "start": 278.41,
      "end": 279.77,
      "text": "我们再注意边缘这个位置"
    },
    {
      "start": 279.77,
      "end": 281.25,
      "text": "是有一个很小的R角"
    },
    {
      "start": 281.25,
      "end": 282.89,
      "text": "也就是说远看很硬了"
    },
    {
      "start": 282.89,
      "end": 284.41,
      "text": "近看或者摸起来的时候"
    },
    {
      "start": 284.41,
      "end": 286.17,
      "text": "在边缘这个位置是有过度的"
    },
    {
      "start": 286.17,
      "end": 287.97,
      "text": "而且在里面屏幕边缘这个位置"
    },
    {
      "start": 287.97,
      "end": 289.13,
      "text": "也是有过度的"
    },
    {
      "start": 289.13,
      "end": 291.33,
      "text": "另外我们注意到它屏幕的弧度这里"
    },
    {
      "start": 291.33,
      "end": 292.61,
      "text": "你可以从侧边看到"
    },
    {
      "start": 292.61,
      "end": 294.57,
      "text": "它的弧度其实是比较小的"
    },
    {
      "start": 294.57,
      "end": 297.89,
      "text": "那么也就是说它更多的是为手感来服务"
    },
    {
      "start": 297.89,
      "end": 300.77,
      "text": "有对比才能知道它的平淡比的一个情况"
    },
    {
      "start": 300.77,
      "end": 303.05,
      "text": "这边应该是非常的清楚"
    },
    {
      "start": 303.05,
      "end": 306.57,
      "text": "中心这台其实两边收窄也是比较明显"
    },
    {
      "start": 306.57,
      "end": 310.41,
      "text": "包括我们看到下巴的部分和iphone来做对比"
    },
    {
      "start": 310.41,
      "end": 312.09,
      "text": "可以说是一眼的差距"
    },
    {
      "start": 312.09,
      "end": 313.81,
      "text": "在上方这里同样如此"
    },
    {
      "start": 313.81,
      "end": 315.05,
      "text": "不客气的说"
    },
    {
      "start": 315.05,
      "end": 317.41,
      "text": "如果你喜欢一个完整的屏幕"
    },
    {
      "start": 317.41,
      "end": 321.41,
      "text": "那么这台机器应该就是目前你市面上需要重点观摩的"
    },
    {
      "start": 321.41,
      "end": 322.37,
      "text": "极端的硬朗"
    },
    {
      "start": 322.37,
      "end": 323.57,
      "text": "同时没有滑孔"
    },
    {
      "start": 323.57,
      "end": 326.01,
      "text": "在这个位置到底能不能看得出来"
    },
    {
      "start": 326.01,
      "end": 327.57,
      "text": "首先我们要说一点"
    },
    {
      "start": 327.57,
      "end": 329.09,
      "text": "当我们熄灭屏幕的时候"
    },
    {
      "start": 329.09,
      "end": 332.01,
      "text": "你会发现这里明显会有一个孔位"
    },
    {
      "start": 332.01,
      "end": 333.69,
      "text": "这其实是屏幕贴膜"
    },
    {
      "start": 333.69,
      "end": 335.73,
      "text": "当我们撕掉它的时候这里就没有了"
    },
    {
      "start": 335.73,
      "end": 338.01,
      "text": "当然为了保护屏幕肯定是有原厂贴膜的"
    },
    {
      "start": 338.01,
      "end": 339.77,
      "text": "当我们点亮屏幕的时候"
    },
    {
      "start": 339.77,
      "end": 341.37,
      "text": "几乎是看不出来"
    },
    {
      "start": 341.37,
      "end": 342.25,
      "text": "大家可以看一下"
    },
    {
      "start": 342.25,
      "end": 345.61,
      "text": "我现在已经是离得我们相机非常的近了"
    },
    {
      "start": 345.61,
      "end": 346.69,
      "text": "有这个贴膜"
    },
    {
      "start": 346.69,
      "end": 348.89,
      "text": "我觉得这个位置是有摄像头的"
    },
    {
      "start": 348.89,
      "end": 350.69,
      "text": "如果没有这个贴膜"
    },
    {
      "start": 350.69,
      "end": 354.25,
      "text": "我觉得这个位置真的是相当的完美了"
    },
    {
      "start": 354.25,
      "end": 355.49,
      "text": "当熄灭屏幕的时候"
    },
    {
      "start": 355.49,
      "end": 358.25,
      "text": "这个贴膜反倒会让我们觉得很明显"
    },
    {
      "start": 358.25,
      "end": 358.73,
      "text": "对吧"
    },
    {
      "start": 358.73,
      "end": 360.05,
      "text": "浅色还行"
    },
    {
      "start": 360.05,
      "end": 361.17,
      "text": "那别的颜色怎么样呢"
    },
    {
      "start": 361.17,
      "end": 363.57,
      "text": "这里是橘黄色的一个背景"
    },
    {
      "start": 363.57,
      "end": 364.33,
      "text": "蓝色的背景"
    },
    {
      "start": 364.33,
      "end": 365.81,
      "text": "那就更什么都看不出来了"
    },
    {
      "start": 365.81,
      "end": 366.21,
      "text": "是不是"
    },
    {
      "start": 366.21,
      "end": 368.37,
      "text": "应该说还是控制的比较的完美"
    },
    {
      "start": 368.37,
      "end": 369.57,
      "text": "上方都是树"
    },
    {
      "start": 369.57,
      "end": 371.77,
      "text": "这是以前有挖孔的时候"
    },
    {
      "start": 371.77,
      "end": 372.97,
      "text": "喜欢这么采用"
    },
    {
      "start": 372.97,
      "end": 374.85,
      "text": "在不同的颜色的情况下"
    },
    {
      "start": 374.85,
      "end": 375.29,
      "text": "怎么样"
    },
    {
      "start": 375.29,
      "end": 376.57,
      "text": "它的显示效果"
    },
    {
      "start": 376.61,
      "end": 377.89,
      "text": "想要找出遗憾"
    },
    {
      "start": 377.89,
      "end": 379.01,
      "text": "都比较困难"
    },
    {
      "start": 379.01,
      "end": 379.29,
      "text": "好"
    },
    {
      "start": 379.29,
      "end": 380.81,
      "text": "我们拿出小微镜"
    },
    {
      "start": 380.0,
      "end": 383.32,
      "text": "那么这边非常的明显"
    },
    {
      "start": 383.32,
      "end": 385.46,
      "text": "是我们比较熟悉的这种类"
    },
    {
      "start": 385.46,
      "end": 387.38,
      "text": "或者是钻石类型的这种排列"
    },
    {
      "start": 387.38,
      "end": 390.28,
      "text": "之前我们说屏下摄像头的屏幕的部分"
    },
    {
      "start": 390.28,
      "end": 392.5,
      "text": "为了照顾到摄像头的部分"
    },
    {
      "start": 392.5,
      "end": 394.56,
      "text": "通常会把亮度做的没有那么高"
    },
    {
      "start": 394.56,
      "end": 395.44,
      "text": "但是这台机器的话"
    },
    {
      "start": 395.44,
      "end": 396.98,
      "text": "亮度就非常的高了"
    },
    {
      "start": 396.98,
      "end": 397.5,
      "text": "接下来的话"
    },
    {
      "start": 397.5,
      "end": 400.12,
      "text": "咱们看一看这台机器的方方面面"
    },
    {
      "start": 400.12,
      "end": 400.74,
      "text": "后船方面"
    },
    {
      "start": 400.74,
      "end": 403.1,
      "text": "我们看到已经支持如此多的品牌"
    },
    {
      "start": 403.1,
      "end": 403.78,
      "text": "个性化里面"
    },
    {
      "start": 403.78,
      "end": 406.04,
      "text": "你可以设置的选项也是比较丰富的"
    },
    {
      "start": 406.04,
      "end": 407.4,
      "text": "这就是买OS里面"
    },
    {
      "start": 407.4,
      "end": 409.26,
      "text": "所有这些都是可以定制的"
    },
    {
      "start": 409.26,
      "end": 410.68,
      "text": "显示的部分几个方面"
    },
    {
      "start": 410.68,
      "end": 412.18,
      "text": "第一个阅读模式"
    },
    {
      "start": 412.18,
      "end": 414.28,
      "text": "看手机时间太长的困扰的话"
    },
    {
      "start": 414.28,
      "end": 417.38,
      "text": "我的建议就是你把它切换到阅读模式"
    },
    {
      "start": 417.38,
      "end": 419.84,
      "text": "你会发现立刻看视频"
    },
    {
      "start": 419.84,
      "end": 421.26,
      "text": "兴趣一下子就降下来了"
    },
    {
      "start": 421.26,
      "end": 422.46,
      "text": "比如说你可以指定"
    },
    {
      "start": 422.46,
      "end": 424.84,
      "text": "某些网站上面是黑白的"
    },
    {
      "start": 424.84,
      "end": 425.84,
      "text": "还是很方便的"
    },
    {
      "start": 425.84,
      "end": 426.38,
      "text": "刷新率部分"
    },
    {
      "start": 426.38,
      "end": 428.24,
      "text": "60 120高刷新率"
    },
    {
      "start": 428.24,
      "end": 429.14,
      "text": "不再过多赘述"
    },
    {
      "start": 429.14,
      "end": 430.34,
      "text": "顶部区域"
    },
    {
      "start": 430.34,
      "end": 433.6,
      "text": "这边明显这是全局设置"
    },
    {
      "start": 433.6,
      "end": 434.44,
      "text": "它是告诉你"
    },
    {
      "start": 434.44,
      "end": 437.1,
      "text": "其他的机器这个选项还得需要"
    },
    {
      "start": 437.1,
      "end": 439.1,
      "text": "我们这台机器完全不用"
    },
    {
      "start": 439.1,
      "end": 441.14,
      "text": "这台机器是屏下摄像头"
    },
    {
      "start": 441.14,
      "end": 443.54,
      "text": "所以在这个位置有一个单独的选项"
    },
    {
      "start": 443.54,
      "end": 446.84,
      "text": "叫做前摄屏幕显示效果微调"
    },
    {
      "start": 446.84,
      "end": 447.84,
      "text": "我们点开它"
    },
    {
      "start": 447.84,
      "end": 449.18,
      "text": "在这里你可以看到"
    },
    {
      "start": 449.18,
      "end": 451.96,
      "text": "在不同的亮度的情况下"
    },
    {
      "start": 451.96,
      "end": 456.76,
      "text": "这个位置看到了吗"
    },
    {
      "start": 456.76,
      "end": 462.3,
      "text": "这次应该也是中兴在这台机器上引入的一套全新的技术"
    },
    {
      "start": 462.3,
      "end": 464.7,
      "text": "以前我们说的所谓的屏幕控光"
    },
    {
      "start": 464.7,
      "end": 469.14,
      "text": "是一套控制针对多个像素点来进行控制"
    },
    {
      "start": 469.14,
      "end": 471.7,
      "text": "但是这台机器是单个像素点控制"
    },
    {
      "start": 471.7,
      "end": 474.7,
      "text": "它可以精细到摄像头的像素的位置"
    },
    {
      "start": 474.7,
      "end": 478.82,
      "text": "你可以让这个位置显示你想要的效果"
    },
    {
      "start": 478.82,
      "end": 480.86,
      "text": "对吧你们想挖孔我也可以挖孔"
    },
    {
      "start": 480.86,
      "end": 483.16,
      "text": "虽然他们说有点凡尔赛是吧"
    },
    {
      "start": 483.16,
      "end": 486.72,
      "text": "甚至可以针对单一的像素去调节它的颜色"
    },
    {
      "start": 486.72,
      "end": 487.96,
      "text": "我这不光挖孔"
    },
    {
      "start": 487.96,
      "end": 489.34,
      "text": "我还能挖成绿孔"
    },
    {
      "start": 489.34,
      "end": 490.78,
      "text": "我还能挖成蓝孔"
    },
    {
      "start": 490.78,
      "end": 492.32,
      "text": "行吧"
    },
    {
      "start": 492.32,
      "end": 494.64,
      "text": "这些小心思还是很好玩的"
    },
    {
      "start": 494.64,
      "end": 495.54,
      "text": "当然如果是我呢"
    },
    {
      "start": 495.54,
      "end": 496.22,
      "text": "没什么说的"
    },
    {
      "start": 496.22,
      "end": 498.72,
      "text": "我就是没挖孔"
    },
    {
      "start": 498.72,
      "end": 501.32,
      "text": "刚才我看到有很多同学弹幕想聊到说"
    },
    {
      "start": 501.32,
      "end": 502.64,
      "text": "能不能看一下"
    },
    {
      "start": 502.64,
      "end": 506.48,
      "text": "它显示这个位置的屏幕排列是什么样子"
    },
    {
      "start": 506.48,
      "end": 508.0,
      "text": "没问题咱们一起来看一看"
    },
    {
      "start": 508.0,
      "end": 510.58,
      "text": "首先常规的部分咱们已经看过了"
    },
    {
      "start": 510.58,
      "end": 512.64,
      "text": "记住这个外观的排列"
    },
    {
      "start": 512.64,
      "end": 514.64,
      "text": "接下来咱们为大家展示一下"
    },
    {
      "start": 514.64,
      "end": 516.48,
      "text": "屏下视线头区域的排列"
    },
    {
      "start": 516.48,
      "end": 518.4,
      "text": "好在这里你可以看到"
    },
    {
      "start": 518.4,
      "end": 520.0,
      "text": "还是类钻石排列"
    },
    {
      "start": 520.0,
      "end": 523.46,
      "text": "但是似乎和刚才的稍微有一点差别"
    },
    {
      "start": 523.46,
      "end": 524.68,
      "text": "有什么差别呢"
    },
    {
      "start": 524.68,
      "end": 525.86,
      "text": "看不出来是吧"
    },
    {
      "start": 525.86,
      "end": 530.08,
      "text": "那我们不妨就把屏幕挖孔的区域"
    },
    {
      "start": 530.08,
      "end": 532.18,
      "text": "和屏幕显示的区域放到一起"
    },
    {
      "start": 532.18,
      "end": 533.48,
      "text": "来拍一张照片试试"
    },
    {
      "start": 533.48,
      "end": 534.54,
      "text": "这个有点困难"
    },
    {
      "start": 534.54,
      "end": 536.62,
      "text": "因为它这个区域非常的小"
    },
    {
      "start": 536.62,
      "end": 538.18,
      "text": "我尝试着找一找"
    },
    {
      "start": 538.18,
      "end": 540.14,
      "text": "好不知道这样行不行"
    },
    {
      "start": 540.14,
      "end": 541.98,
      "text": "OK来同学们"
    },
    {
      "start": 541.98,
      "end": 544.5,
      "text": "咱们下面一起来见证的就是"
    },
    {
      "start": 544.5,
      "end": 546.54,
      "text": "在这一个屏幕上面"
    },
    {
      "start": 546.54,
      "end": 549.38,
      "text": "你可以看到两种像素排列"
    },
    {
      "start": 549.38,
      "end": 552.56,
      "text": "下方的蓝色紫像素是类似方形的"
    },
    {
      "start": 552.56,
      "end": 555.88,
      "text": "上方的蓝色紫像素是类似圆形的"
    },
    {
      "start": 555.88,
      "end": 557.12,
      "text": "只有在显微镜下"
    },
    {
      "start": 557.12,
      "end": 559.96,
      "text": "我们才能看出如此的差别"
    },
    {
      "start": 559.96,
      "end": 562.0,
      "text": "但是这个差别已经非常的小了"
    },
    {
      "start": 562.0,
      "end": 564.38,
      "text": "也就是说我们肉眼去观看这个屏幕的时候"
    },
    {
      "start": 564.38,
      "end": 565.94,
      "text": "几乎已经看不出差别了"
    },
    {
      "start": 565.94,
      "end": 570.38,
      "text": "可以说全新升级的AXON40 Ultra的屏幕部分的表现"
    },
    {
      "start": 570.38,
      "end": 572.38,
      "text": "是超出我们的预期的"
    },
    {
      "start": 572.38,
      "end": 574.38,
      "text": "感谢观看"
    },
    {
      "start": 576.66,
      "end": 585.99,
      "text": "那对称的扬声器"
    },
    {
      "start": 585.99,
      "end": 586.79,
      "text": "零息助理"
    },
    {
      "start": 586.79,
      "end": 587.71,
      "text": "侧边按钮这里"
    },
    {
      "start": 587.71,
      "end": 589.23,
      "text": "快速的调用一些程序"
    },
    {
      "start": 589.23,
      "end": 590.19,
      "text": "小窗"
    },
    {
      "start": 590.19,
      "end": 592.07,
      "text": "我们可以通过分屏的方式"
    },
    {
      "start": 592.07,
      "end": 594.51,
      "text": "开启更多的程序"
    },
    {
      "start": 594.51,
      "end": 597.15,
      "text": "而且可以不同的程序去切换"
    },
    {
      "start": 597.15,
      "end": 599.55,
      "text": "来看一下它的屏幕指纹区域"
    },
    {
      "start": 599.55,
      "end": 601.91,
      "text": "这台手机是比较我们自然的位置"
    },
    {
      "start": 601.91,
      "end": 602.99,
      "text": "指纹识别的样式"
    },
    {
      "start": 602.99,
      "end": 604.91,
      "text": "可以根据自己的需求来做定制"
    },
    {
      "start": 604.91,
      "end": 606.39,
      "text": "人脸识别"
    },
    {
      "start": 606.39,
      "end": 608.03,
      "text": "321"
    },
    {
      "start": 608.03,
      "end": 611.19,
      "text": "然后我们遮挡嘴巴"
    },
    {
      "start": 611.19,
      "end": 612.99,
      "text": "我们遮挡鼻子"
    },
    {
      "start": 612.99,
      "end": 614.27,
      "text": "还是可以"
    },
    {
      "start": 614.27,
      "end": 615.35,
      "text": "那目的非常简单"
    },
    {
      "start": 615.35,
      "end": 617.55,
      "text": "就是在我们戴口罩的时候"
    },
    {
      "start": 617.55,
      "end": 619.59,
      "text": "也要解锁"
    },
    {
      "start": 619.59,
      "end": 621.51,
      "text": "现在你看我遮挡的面部"
    },
    {
      "start": 621.51,
      "end": 622.71,
      "text": "已经是比较多的了"
    },
    {
      "start": 622.71,
      "end": 625.15,
      "text": "嘴、鼻子、脸都没了"
    },
    {
      "start": 625.15,
      "end": 626.15,
      "text": "觉得能解锁打个一"
    },
    {
      "start": 626.15,
      "end": 627.63,
      "text": "觉得解不了打一盖"
    },
    {
      "start": 627.63,
      "end": 631.03,
      "text": "321"
    },
    {
      "start": 631.03,
      "end": 632.15,
      "text": "还是可以解锁"
    },
    {
      "start": 632.15,
      "end": 634.43,
      "text": "那接下来咱们看的是它的拍照的部分"
    },
    {
      "start": 634.43,
      "end": 636.67,
      "text": "在下方是有不少的选项"
    },
    {
      "start": 636.67,
      "end": 640.31,
      "text": "这里还有中型特色的相机家族"
    },
    {
      "start": 640.31,
      "end": 642.91,
      "text": "相机的部分是有一些特殊的亮点"
    },
    {
      "start": 642.91,
      "end": 644.27,
      "text": "首先是三摄"
    },
    {
      "start": 644.27,
      "end": 646.67,
      "text": "都是6400万的高像素"
    },
    {
      "start": 646.67,
      "end": 647.75,
      "text": "然后我们来看一下"
    },
    {
      "start": 647.75,
      "end": 649.27,
      "text": "里面可设置的选项"
    },
    {
      "start": 649.27,
      "end": 649.95,
      "text": "人脸识别"
    },
    {
      "start": 649.95,
      "end": 650.95,
      "text": "人眼识别"
    },
    {
      "start": 650.95,
      "end": 652.15,
      "text": "根据眼睛这块"
    },
    {
      "start": 652.15,
      "end": 653.59,
      "text": "防抖效果增强等等"
    },
    {
      "start": 653.59,
      "end": 654.83,
      "text": "视频选项这里"
    },
    {
      "start": 654.83,
      "end": 655.75,
      "text": "我们可以看到"
    },
    {
      "start": 655.75,
      "end": 657.59,
      "text": "超高清8K"
    },
    {
      "start": 657.59,
      "end": 660.63,
      "text": "这是最高的可以支持8K视频的拍摄"
    },
    {
      "start": 660.63,
      "end": 663.35,
      "text": "同时下面有4K 60帧盒"
    },
    {
      "start": 663.35,
      "end": 666.75,
      "text": "巨夸张的4K 120帧"
    },
    {
      "start": 666.75,
      "end": 668.79,
      "text": "这在市面上是极其罕见的"
    },
    {
      "start": 668.79,
      "end": 672.15,
      "text": "当我们去户外拍摄一些比较重要的场景的时候"
    },
    {
      "start": 672.15,
      "end": 675.31,
      "text": "高帧率和高分辨率同时获取"
    },
    {
      "start": 675.31,
      "end": 676.15,
      "text": "并不容易"
    },
    {
      "start": 676.15,
      "end": 677.39,
      "text": "还有一个小的功能"
    },
    {
      "start": 677.39,
      "end": 679.47,
      "text": "就是适合我们在户外抓拍"
    },
    {
      "start": 679.55,
      "end": 680.75,
      "text": "西平状态下"
    },
    {
      "start": 680.75,
      "end": 683.39,
      "text": "双击音量键可以完成拍照"
    },
    {
      "start": 683.39,
      "end": 684.95,
      "text": "就比较适合我们去户外"
    },
    {
      "start": 684.95,
      "end": 686.79,
      "text": "遇到一些极端特殊的情况"
    },
    {
      "start": 686.79,
      "end": 687.99,
      "text": "需要拍摄的时候"
    },
    {
      "start": 687.99,
      "end": 689.71,
      "text": "只需要点击两下"
    },
    {
      "start": 689.71,
      "end": 691.67,
      "text": "侧边这个按钮就已经拍摄完毕"
    },
    {
      "start": 691.67,
      "end": 693.95,
      "text": "并且当你每拍摄一张的时候"
    },
    {
      "start": 693.95,
      "end": 695.83,
      "text": "它会拍摄三张照片"
    },
    {
      "start": 695.83,
      "end": 697.51,
      "text": "一张是常规曝光的"
    },
    {
      "start": 697.51,
      "end": 698.55,
      "text": "一张是低曝光"
    },
    {
      "start": 698.55,
      "end": 700.03,
      "text": "一张是过多曝光的"
    },
    {
      "start": 700.03,
      "end": 701.67,
      "text": "提高你拍摄的成功率"
    },
    {
      "start": 701.67,
      "end": 703.15,
      "text": "这里还有个比较特殊的"
    },
    {
      "start": 703.15,
      "end": 705.47,
      "text": "这边是超高清8K视频"
    },
    {
      "start": 705.47,
      "end": 706.59,
      "text": "我们现在在广角"
    },
    {
      "start": 706.59,
      "end": 708.55,
      "text": "一辈变焦和长焦端"
    },
    {
      "start": 708.55,
      "end": 710.39,
      "text": "三美镜头组的情况下"
    },
    {
      "start": 710.39,
      "end": 712.95,
      "text": "都能进行8K视频的拍摄"
    },
    {
      "start": 712.95,
      "end": 715.23,
      "text": "这个能力是非常强悍"
    },
    {
      "start": 715.23,
      "end": 716.63,
      "text": "另外在录像的时候"
    },
    {
      "start": 716.63,
      "end": 718.51,
      "text": "这边你可以去选择麦克风"
    },
    {
      "start": 718.51,
      "end": 720.83,
      "text": "这边你可以选择前置录音"
    },
    {
      "start": 720.83,
      "end": 722.63,
      "text": "也可以选择后置录音"
    },
    {
      "start": 722.63,
      "end": 723.19,
      "text": "在这个位置"
    },
    {
      "start": 723.19,
      "end": 725.03,
      "text": "还可以选择全景录音"
    },
    {
      "start": 725.03,
      "end": 726.67,
      "text": "夜景部分也是完整支持"
    },
    {
      "start": 726.67,
      "end": 729.71,
      "text": "专门有一枚35毫米的人像镜头"
    },
    {
      "start": 729.71,
      "end": 730.71,
      "text": "人文街拍这里"
    },
    {
      "start": 730.71,
      "end": 732.23,
      "text": "对于街拍来说很重要"
    },
    {
      "start": 732.23,
      "end": 733.87,
      "text": "我们知道扫街最重要的"
    },
    {
      "start": 733.87,
      "end": 735.07,
      "text": "就怕对不上焦"
    },
    {
      "start": 735.15,
      "end": 736.67,
      "text": "它增加了一个叫做"
    },
    {
      "start": 736.67,
      "end": 738.47,
      "text": "自动对焦的人文街拍"
    },
    {
      "start": 738.47,
      "end": 739.39,
      "text": "御对焦模式"
    },
    {
      "start": 739.39,
      "end": 740.59,
      "text": "开启之后的话"
    },
    {
      "start": 740.0,
      "end": 742.7,
      "text": "就可以变成全局对焦"
    },
    {
      "start": 742.7,
      "end": 744.04,
      "text": "而且在扫街的时候"
    },
    {
      "start": 744.04,
      "end": 745.46,
      "text": "这里还有一个胶片模式"
    },
    {
      "start": 745.46,
      "end": 747.78,
      "text": "而且这边还有一个水平仪"
    },
    {
      "start": 747.78,
      "end": 749.58,
      "text": "整合到了快门当中"
    },
    {
      "start": 749.58,
      "end": 751.16,
      "text": "回到前摄这里"
    },
    {
      "start": 751.16,
      "end": 753.34,
      "text": "屏下摄像头要想解决拍照"
    },
    {
      "start": 753.34,
      "end": 754.6,
      "text": "又想解决显示"
    },
    {
      "start": 754.6,
      "end": 755.8,
      "text": "其实都不是太容易"
    },
    {
      "start": 755.8,
      "end": 756.78,
      "text": "好"
    },
    {
      "start": 756.78,
      "end": 758.9,
      "text": "我就是这么随便拍了一张"
    },
    {
      "start": 758.9,
      "end": 760.74,
      "text": "大家可以大致的来感受一下"
    },
    {
      "start": 760.74,
      "end": 761.76,
      "text": "毛发的部分"
    },
    {
      "start": 761.76,
      "end": 763.6,
      "text": "是不是足够多的细节"
    },
    {
      "start": 763.6,
      "end": 764.7,
      "text": "那么这个效果"
    },
    {
      "start": 764.7,
      "end": 765.7,
      "text": "不知道大家觉得怎么样"
    },
    {
      "start": 765.7,
      "end": 768.02,
      "text": "好 这次拍照部分"
    },
    {
      "start": 768.02,
      "end": 768.96,
      "text": "还有一个重点"
    },
    {
      "start": 768.96,
      "end": 770.76,
      "text": "就是中兴最近这一两年"
    },
    {
      "start": 770.76,
      "end": 773.3,
      "text": "一直在力推的功能叫做多摄同拍"
    },
    {
      "start": 773.3,
      "end": 775.28,
      "text": "就是后面这三枚镜头"
    },
    {
      "start": 775.28,
      "end": 776.16,
      "text": "在拍摄的时候"
    },
    {
      "start": 776.16,
      "end": 777.56,
      "text": "获得同样的效果"
    },
    {
      "start": 777.56,
      "end": 778.86,
      "text": "除了一个预览框之外"
    },
    {
      "start": 778.86,
      "end": 779.58,
      "text": "那么在下方"
    },
    {
      "start": 779.58,
      "end": 781.04,
      "text": "还有广角和长焦"
    },
    {
      "start": 781.04,
      "end": 782.62,
      "text": "两个预览框在这里"
    },
    {
      "start": 782.62,
      "end": 784.18,
      "text": "就是你拍一次的时候"
    },
    {
      "start": 784.18,
      "end": 786.92,
      "text": "这三个镜头是同时工作的"
    },
    {
      "start": 786.92,
      "end": 787.66,
      "text": "比如说我拍"
    },
    {
      "start": 787.66,
      "end": 788.82,
      "text": "我旁边这有一盆花"
    },
    {
      "start": 788.82,
      "end": 790.98,
      "text": "那么回到这个位置"
    },
    {
      "start": 790.98,
      "end": 792.9,
      "text": "大家看到这是这个花盆"
    },
    {
      "start": 792.9,
      "end": 795.92,
      "text": "但是我们可以通过变焦的方式"
    },
    {
      "start": 795.92,
      "end": 798.9,
      "text": "获得它广角端"
    },
    {
      "start": 798.9,
      "end": 800.04,
      "text": "那么回到一倍变焦"
    },
    {
      "start": 800.04,
      "end": 800.74,
      "text": "长焦"
    },
    {
      "start": 800.74,
      "end": 802.2,
      "text": "放大的细节"
    },
    {
      "start": 802.2,
      "end": 802.64,
      "text": "注意啊"
    },
    {
      "start": 802.64,
      "end": 803.92,
      "text": "这个放大的细节呢"
    },
    {
      "start": 803.92,
      "end": 805.4,
      "text": "是全像素放大的细节"
    },
    {
      "start": 805.4,
      "end": 807.0,
      "text": "甚至呢"
    },
    {
      "start": 807.0,
      "end": 807.96,
      "text": "我们还可以再放大"
    },
    {
      "start": 807.96,
      "end": 812.32,
      "text": "这就是多摄同拍的能力"
    },
    {
      "start": 812.32,
      "end": 812.96,
      "text": "这里呢"
    },
    {
      "start": 812.96,
      "end": 815.08,
      "text": "还有多摄同拍录像"
    },
    {
      "start": 815.08,
      "end": 816.12,
      "text": "在这位置"
    },
    {
      "start": 816.12,
      "end": 817.14,
      "text": "对吧"
    },
    {
      "start": 817.14,
      "end": 818.2,
      "text": "我们点完之后"
    },
    {
      "start": 818.2,
      "end": 819.1,
      "text": "大家看到这里有"
    },
    {
      "start": 819.1,
      "end": 820.7,
      "text": "123456"
    },
    {
      "start": 820.7,
      "end": 822.28,
      "text": "六个取景器"
    },
    {
      "start": 822.28,
      "end": 823.14,
      "text": "经常啊"
    },
    {
      "start": 823.14,
      "end": 825.48,
      "text": "就是又想给你家宝宝来个特写"
    },
    {
      "start": 825.48,
      "end": 826.1,
      "text": "但是呢"
    },
    {
      "start": 826.1,
      "end": 828.74,
      "text": "又想给全场景拍个大场景"
    },
    {
      "start": 828.74,
      "end": 829.46,
      "text": "这个时候"
    },
    {
      "start": 829.46,
      "end": 831.6,
      "text": "多摄同录就非常重要了"
    },
    {
      "start": 831.6,
      "end": 832.88,
      "text": "大家看到我们在录像的时候"
    },
    {
      "start": 832.88,
      "end": 835.68,
      "text": "可以选123三个镜头组最终来入镜"
    },
    {
      "start": 835.68,
      "end": 836.44,
      "text": "而且呢"
    },
    {
      "start": 836.44,
      "end": 837.94,
      "text": "在录制的时候呢"
    },
    {
      "start": 837.94,
      "end": 841.6,
      "text": "你还可以去选择出来的这个最终这个画面"
    },
    {
      "start": 841.6,
      "end": 842.86,
      "text": "这是录全景啊"
    },
    {
      "start": 842.86,
      "end": 844.08,
      "text": "比如三个小朋友在跳舞"
    },
    {
      "start": 844.08,
      "end": 846.26,
      "text": "然后这是录中间这个05的特写"
    },
    {
      "start": 846.26,
      "end": 847.78,
      "text": "然后这是录导演我本人"
    },
    {
      "start": 847.78,
      "end": 849.04,
      "text": "而且这三个画面呢"
    },
    {
      "start": 849.04,
      "end": 850.86,
      "text": "和可以在录的过程当中"
    },
    {
      "start": 850.86,
      "end": 852.42,
      "text": "你不停的去换位置"
    },
    {
      "start": 852.42,
      "end": 852.84,
      "text": "对吧"
    },
    {
      "start": 852.84,
      "end": 855.44,
      "text": "让你当一个导演的过过瘾"
    },
    {
      "start": 855.44,
      "end": 856.02,
      "text": "OK"
    },
    {
      "start": 856.02,
      "end": 857.48,
      "text": "那么看到这里呢"
    },
    {
      "start": 857.48,
      "end": 860.56,
      "text": "这就是这台中兴的AXON40 Ultra"
    },
    {
      "start": 860.56,
      "end": 862.3,
      "text": "我觉得最重要的两个方面"
    },
    {
      "start": 862.3,
      "end": 863.54,
      "text": "第一个屏幕"
    },
    {
      "start": 863.54,
      "end": 864.38,
      "text": "这款呢"
    },
    {
      "start": 864.38,
      "end": 866.14,
      "text": "屏下摄像头的这个表现"
    },
    {
      "start": 866.14,
      "end": 870.28,
      "text": "我觉得已经趋近于我们想要的那个完美的效果"
    },
    {
      "start": 870.28,
      "end": 871.74,
      "text": "而且大家更有印象啊"
    },
    {
      "start": 871.74,
      "end": 873.32,
      "text": "之前咱们看到这个位置呢"
    },
    {
      "start": 873.32,
      "end": 875.38,
      "text": "经常是在高亮的情况下"
    },
    {
      "start": 875.38,
      "end": 876.1,
      "text": "它会露像"
    },
    {
      "start": 876.1,
      "end": 877.1,
      "text": "我们看看这台机器呢"
    },
    {
      "start": 877.1,
      "end": 877.98,
      "text": "你可以看到啊"
    },
    {
      "start": 877.98,
      "end": 879.6,
      "text": "反正我用肉眼看的话呢"
    },
    {
      "start": 879.6,
      "end": 882.7,
      "text": "是很难看到以前那个明显的阴影的部分"
    },
    {
      "start": 882.7,
      "end": 884.14,
      "text": "这是它的屏幕部分"
    },
    {
      "start": 884.14,
      "end": 885.32,
      "text": "我觉得还是很厉害的"
    },
    {
      "start": 885.32,
      "end": 888.12,
      "text": "然后呢就是它的拍照的部分也很有特色"
    },
    {
      "start": 888.12,
      "end": 889.16,
      "text": "三枚镜头呢"
    },
    {
      "start": 889.16,
      "end": 891.26,
      "text": "想要做到多摄同拍的效果"
    },
    {
      "start": 891.26,
      "end": 891.82,
      "text": "而且呢"
    },
    {
      "start": 891.82,
      "end": 894.3,
      "text": "是两枚索尼的MX787"
    },
    {
      "start": 894.3,
      "end": 895.64,
      "text": "外加一枚潜望镜头"
    },
    {
      "start": 895.64,
      "end": 896.14,
      "text": "OK"
    },
    {
      "start": 896.14,
      "end": 898.18,
      "text": "那么这台中兴的AXON40 Ultra"
    },
    {
      "start": 898.18,
      "end": 899.72,
      "text": "我们就为大家开箱到这里"
    },
    {
      "start": 899.72,
      "end": 900.92,
      "text": "大家可以满分"
    },
    {
      "start": 900.92,
      "end": 902.0,
      "text": "十分的情况下"
    },
    {
      "start": 902.0,
      "end": 902.84,
      "text": "给它打一个分数"
    },
    {
      "start": 902.84,
      "end": 905.52,
      "text": "你觉得这台机器是否符合你的预期呢"
    },
    {
      "start": 905.52,
      "end": 906.7,
      "text": "咱就放开了吧"
    },
    {
      "start": 906.7,
      "end": 907.58,
      "text": "咱就把它撕了"
    },
    {
      "start": 907.58,
      "end": 907.9,
      "text": "行不行"
    },
    {
      "start": 907.9,
      "end": 908.96,
      "text": "哎呀"
    },
    {
      "start": 908.96,
      "end": 910.5,
      "text": "我跟大家说一下啊"
    },
    {
      "start": 910.5,
      "end": 912.72,
      "text": "咱们这是科技美学的直播间啊"
    },
    {
      "start": 912.72,
      "end": 914.4,
      "text": "咱们不要轻易模仿啊"
    },
    {
      "start": 914.4,
      "end": 915.46,
      "text": "你们自己买了的话"
    },
    {
      "start": 915.46,
      "end": 916.38,
      "text": "不要像我这样啊"
    },
    {
      "start": 916.38,
      "end": 917.26,
      "text": "我是看到这个"
    },
    {
      "start": 917.26,
      "end": 918.06,
      "text": "总是有同学说"
    },
    {
      "start": 918.06,
      "end": 919.8,
      "text": "你这个挖孔太明显"
    },
    {
      "start": 919.8,
      "end": 921.12,
      "text": "我今天就让你看看"
    },
    {
      "start": 921.12,
      "end": 922.08,
      "text": "它到底有多明显"
    },
    {
      "start": 922.08,
      "end": 928.58,
      "text": "我看谁还说明显"
    },
    {
      "start": 928.58,
      "end": 929.48,
      "text": "怎么样"
    },
    {
      "start": 929.48,
      "end": 932.68,
      "text": "这回没有贴膜影响了吧"
    },
    {
      "start": 932.68,
      "end": 935.38,
      "text": "是不是非常难以看出"
    },
    {
      "start": 935.38,
      "end": 936.98,
      "text": "它是有摄像头的"
    },
    {
      "start": 936.98,
      "end": 937.84,
      "text": "很多时候啊"
    },
    {
      "start": 937.84,
      "end": 939.5,
      "text": "这个技术的投入这个钱"
    },
    {
      "start": 939.5,
      "end": 941.28,
      "text": "是真的不白花"
    },
    {
      "start": 941.28,
      "end": 941.78,
      "text": "OK"
    },
    {
      "start": 941.78,
      "end": 943.3,
      "text": "这就是科技美学的直播间"
    },
    {
      "start": 943.3,
      "end": 944.74,
      "text": "感谢大家来看我们的直播"
    },
    {
      "start": 945.0,
      "end": 946.38,
      "text": "为它的详细测试呢"
    },
    {
      "start": 946.38,
      "end": 948.44,
      "text": "请大家期待我们后续的内容"
    },
    {
      "start": 948.44,
      "end": 950.44,
      "text": "我们详细测试再见"
    },
    {
      "start": 950.44,
      "end": 953.7,
      "text": "白虾我这个贴膜了"
    },
    {
      "start": 953.7,
      "end": 954.16,
      "text": "哎呀"
    },
    {
      "start": 954.16,
      "end": 955.94,
      "text": "这么完美的贴膜"
    },
    {
      "start": 955.94,
      "end": 960.53,
      "text": "它上面是没有这个挖孔就好了"
    },
    {
      "start": 960.53,
      "end": 962.21,
      "text": "那我把这个贴膜给它倒着贴"
    },
    {
      "start": 962.21,
      "end": 962.91,
      "text": "不就完了吗"
    },
    {
      "start": 962.91,
      "end": 965.34,
      "text": "完了"
    },
    {
      "start": 965.34,
      "end": 966.34,
      "text": "完整了"
    },
    {
      "start": 966.34,
      "end": 967.76,
      "text": "我就是反面例子啊"
    },
    {
      "start": 967.76,
      "end": 969.12,
      "text": "大家千万不要向我学习"
    },
    {
      "start": 969.12,
      "end": 970.26,
      "text": "把这个撕下来"
    },
    {
      "start": 970.26,
      "end": 971.52,
      "text": "撕下来太可惜了"
    },
    {
      "start": 971.52,
      "end": 972.7,
      "text": "这个贴膜本身很好"
    },
    {
      "start": 972.7,
      "end": 973.5,
      "text": "另外呢"
    },
    {
      "start": 973.5,
      "end": 974.64,
      "text": "要是没这个挖孔"
    },
    {
      "start": 974.64,
      "end": 975.34,
      "text": "可能就更好"
    },
    {
      "start": 975.34,
      "end": 975.94,
      "text": "哎呀"
    },
    {
      "start": 975.94,
      "end": 976.64,
      "text": "总之就是"
    },
    {
      "start": 976.64,
      "end": 979.82,
      "text": "是一台让人觉得屏幕真的很完美的机器"
    },
    {
      "start": 979.82,
      "end": 980.58,
      "text": "很精致"
    },
    {
      "start": 980.58,
      "end": 981.38,
      "text": "没有遗憾"
    }
  ]
}