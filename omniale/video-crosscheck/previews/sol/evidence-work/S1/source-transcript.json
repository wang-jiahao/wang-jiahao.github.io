{
  "media": "../../media/source.mp4",
  "requested_range": [
    0,
    986.069
  ],
  "model": "large-v3-turbo",
  "engine": "faster-whisper/local CPU; no cloud media service",
  "language": "zh",
  "language_probability": 1,
  "segments": [
    {
      "start": 0.08,
      "end": 2.92,
      "text": "嗨 大家好 我是拿言 欢迎来到科技美学的直播间"
    },
    {
      "start": 2.92,
      "end": 9.08,
      "text": "那今天我们和大家一起观看的就是刚刚发布的中兴Axon全新的旗舰机型"
    },
    {
      "start": 9.08,
      "end": 13.36,
      "text": "我们过去这些年一直期待的就是完美无缺的屏幕"
    },
    {
      "start": 13.36,
      "end": 16.94,
      "text": "但是呢 非常遗憾啊 因为前置摄像头的存在"
    },
    {
      "start": 16.94,
      "end": 19.52,
      "text": "没有一款完美的屏幕能够打动我"
    },
    {
      "start": 19.52,
      "end": 23.82,
      "text": "而在今年2022年 中兴的Axon40系列"
    },
    {
      "start": 23.82,
      "end": 26.7,
      "text": "在屏下摄像头这块是不是变得更完美了呢"
    },
    {
      "start": 26.7,
      "end": 30.3,
      "text": "咱们不废话 抓紧来看真机的表现"
    },
    {
      "start": 30.3,
      "end": 34.1,
      "text": "OK 中兴的Axon40 Ultra"
    },
    {
      "start": 34.1,
      "end": 36.74,
      "text": "首先我们看一下包装盒这边40"
    },
    {
      "start": 36.74,
      "end": 39.12,
      "text": "在下方呢 是有中兴的标志"
    },
    {
      "start": 39.12,
      "end": 45.02,
      "text": "OK 盒子本身呢 上面是这种类似磨砂的亲肤材质"
    },
    {
      "start": 45.02,
      "end": 46.42,
      "text": "是颇有质感的感觉"
    },
    {
      "start": 46.42,
      "end": 49.34,
      "text": "盒子十分的厚实"
    },
    {
      "start": 49.34,
      "end": 52.4,
      "text": "产品本身拿在手里呢 不算特别的重"
    },
    {
      "start": 52.4,
      "end": 53.98,
      "text": "也没有那么压手"
    },
    {
      "start": 53.98,
      "end": 57.06,
      "text": "好了 每个配件呢 都有包装盒"
    },
    {
      "start": 57.06,
      "end": 58.12,
      "text": "咱们逐个打开"
    },
    {
      "start": 58.12,
      "end": 60.62,
      "text": "首先 卡针不展示了"
    },
    {
      "start": 60.62,
      "end": 64.9,
      "text": "VIP卡啊 很多同学可能会把包装里边的卡片丢掉"
    },
    {
      "start": 64.9,
      "end": 66.9,
      "text": "劝你在丢掉之前 一定要仔细看一看"
    },
    {
      "start": 66.9,
      "end": 68.18,
      "text": "上面会有一些权益"
    },
    {
      "start": 68.18,
      "end": 69.94,
      "text": "纸片不展示了 宝壳"
    },
    {
      "start": 69.94,
      "end": 70.96,
      "text": "充电器"
    },
    {
      "start": 70.96,
      "end": 72.76,
      "text": "还算比较小小"
    },
    {
      "start": 72.76,
      "end": 74.84,
      "text": "这边呢 是单独的PD接口"
    },
    {
      "start": 74.84,
      "end": 76.92,
      "text": "80瓦的氮化加充电器"
    },
    {
      "start": 76.92,
      "end": 79.04,
      "text": "C口的好处呢 就是可以通用的啊"
    },
    {
      "start": 79.04,
      "end": 81.62,
      "text": "线材部分 你可以看到还是比较的粗的"
    },
    {
      "start": 81.62,
      "end": 84.7,
      "text": "也有一定的硬度"
    },
    {
      "start": 84.7,
      "end": 86.7,
      "text": "99厘米的双C口数据线"
    },
    {
      "start": 86.7,
      "end": 87.7,
      "text": "宝壳这边"
    },
    {
      "start": 87.7,
      "end": 90.7,
      "text": "可以听到内部呢 是凸点 外部呢 是光滑"
    },
    {
      "start": 90.7,
      "end": 92.46,
      "text": "接下来呢 就是我们今天的主角"
    },
    {
      "start": 92.46,
      "end": 94.7,
      "text": "中兴的AXON 40 Ultra"
    },
    {
      "start": 94.7,
      "end": 96.7,
      "text": "拿在手里 很修长的感觉"
    },
    {
      "start": 96.7,
      "end": 103.47,
      "text": "好 那么整个正面的话呢 是一个双微曲面的表面"
    },
    {
      "start": 103.47,
      "end": 106.47,
      "text": "那么手感部分 我们手指握在两侧的时候"
    },
    {
      "start": 106.47,
      "end": 108.03,
      "text": "不论是左边还是右边"
    },
    {
      "start": 108.03,
      "end": 111.51,
      "text": "它整体的触感的前后弧度是统一的"
    },
    {
      "start": 111.51,
      "end": 113.11,
      "text": "这里还真的挺特别 在哪呢"
    },
    {
      "start": 113.11,
      "end": 116.51,
      "text": "就是我们之前说到很多的曲面屏机型和边框部分"
    },
    {
      "start": 116.51,
      "end": 118.03,
      "text": "可能会有一个小小的接缝"
    },
    {
      "start": 118.03,
      "end": 120.71,
      "text": "拇指滑过的时候 会有一点点割裂的感觉"
    },
    {
      "start": 120.71,
      "end": 123.11,
      "text": "那么这台机器的话呢 几乎没有啊"
    },
    {
      "start": 123.11,
      "end": 127.11,
      "text": "看细节的话呢 整个的玻璃和金属边框呢"
    },
    {
      "start": 127.11,
      "end": 128.11,
      "text": "严丝合缝的在一起"
    },
    {
      "start": 128.11,
      "end": 131.59,
      "text": "来看一下背面 撕掉贴膜"
    },
    {
      "start": 131.59,
      "end": 134.19,
      "text": "好 这个背面说实话有点夸张"
    },
    {
      "start": 134.19,
      "end": 135.99,
      "text": "三枚镜头组"
    },
    {
      "start": 135.99,
      "end": 141.03,
      "text": "这次的亮点呢 就是双索尼的MX787传感器"
    },
    {
      "start": 141.03,
      "end": 144.15,
      "text": "三枚镜头组呢 都可以被称作主摄"
    },
    {
      "start": 144.15,
      "end": 146.87,
      "text": "同时呢 有一个潜望镜式的镜头组"
    },
    {
      "start": 146.87,
      "end": 149.67,
      "text": "在镜头组的外圈设计这里面呢"
    },
    {
      "start": 149.67,
      "end": 151.35,
      "text": "是颇有特色的啊"
    },
    {
      "start": 151.35,
      "end": 154.11,
      "text": "首先呢 是我们看到这种类似小的阶梯状的设计"
    },
    {
      "start": 154.11,
      "end": 156.23,
      "text": "在边框这里呢 是两段式的凸起"
    },
    {
      "start": 156.23,
      "end": 159.23,
      "text": "圈层旁边这里还有一圈小小的切边的装饰"
    },
    {
      "start": 159.23,
      "end": 162.31,
      "text": "在下方这里呢 有一个亮片的金属装饰"
    },
    {
      "start": 162.31,
      "end": 164.11,
      "text": "灯光滑过的时候啊 很漂亮"
    },
    {
      "start": 164.11,
      "end": 167.87,
      "text": "那同时背板这里呢 用的是这种粗磨砂的材质"
    },
    {
      "start": 167.87,
      "end": 169.35,
      "text": "颇有那种自然的纹理"
    },
    {
      "start": 169.35,
      "end": 171.27,
      "text": "能听到这个声音啊"
    },
    {
      "start": 171.27,
      "end": 175.31,
      "text": "但其实呢 它是这种用玻璃的特殊工艺来实现的"
    },
    {
      "start": 175.31,
      "end": 177.79,
      "text": "包括下方 我看到中兴的这个小小的logo"
    },
    {
      "start": 177.79,
      "end": 182.33,
      "text": "所以整个背板这块呢 内缘 外方十分的硬朗的设计"
    },
    {
      "start": 182.33,
      "end": 184.91,
      "text": "顶部我们看这边 哦 还有红外线的接口"
    },
    {
      "start": 184.91,
      "end": 186.91,
      "text": "以及顶部的扬声器 底部 除了扬声器之外呢"
    },
    {
      "start": 186.91,
      "end": 188.91,
      "text": "这里还有卡针的部分"
    },
    {
      "start": 188.91,
      "end": 190.91,
      "text": "SIM卡托这边呢 是叠放"
    },
    {
      "start": 190.91,
      "end": 192.91,
      "text": "同时呢 有一次白色的胶圈"
    },
    {
      "start": 192.91,
      "end": 194.91,
      "text": "起到一个防水的作用"
    },
    {
      "start": 194.91,
      "end": 197.91,
      "text": "那么整机呢 应该说视觉观感上是非常硬朗的"
    },
    {
      "start": 197.91,
      "end": 200.91,
      "text": "毫无疑问啊 它可以很轻松的摆放在桌面上面"
    },
    {
      "start": 200.91,
      "end": 203.91,
      "text": "我的手机能立起来 你的可以吗"
    },
    {
      "start": 203.91,
      "end": 207.91,
      "text": "上方下方金属到中间呢 有一个非常明显的收窄"
    },
    {
      "start": 207.91,
      "end": 211.91,
      "text": "同时呢 在电源键和音量键这里 有一个很明显的下沉"
    },
    {
      "start": 211.91,
      "end": 215.91,
      "text": "所以呢 整个机型的设计做到了相当的极致的状态"
    },
    {
      "start": 215.91,
      "end": 217.91,
      "text": "来吧 同学们 在不点亮屏幕的情况下"
    },
    {
      "start": 217.91,
      "end": 221.91,
      "text": "大家给这台AXON40 Ultra的外观打一个分数"
    },
    {
      "start": 221.91,
      "end": 223.91,
      "text": "那么套上宝格之后呢 你会发觉它的颜色部分"
    },
    {
      "start": 223.91,
      "end": 225.91,
      "text": "似乎一下子变成浅灰色"
    },
    {
      "start": 225.91,
      "end": 227.91,
      "text": "整个颜值部分呢 有了很明显的一个变化"
    },
    {
      "start": 227.91,
      "end": 229.91,
      "text": "接下来我们开机"
    },
    {
      "start": 229.91,
      "end": 231.91,
      "text": "ZT 中心的标志"
    },
    {
      "start": 231.91,
      "end": 233.91,
      "text": "MyOS 全新的系统"
    },
    {
      "start": 233.91,
      "end": 238.91,
      "text": "一个很漂亮的 5G先锋 微快不破即可出放"
    },
    {
      "start": 238.91,
      "end": 241.91,
      "text": "不知道大家的第一印象怎么样啊"
    },
    {
      "start": 241.91,
      "end": 243.91,
      "text": "从我个人这个角度来看的话呢"
    },
    {
      "start": 243.91,
      "end": 245.91,
      "text": "它的两边的边框是比较窄的"
    },
    {
      "start": 245.91,
      "end": 248.91,
      "text": "那么上下部分啊 基本上算是等宽"
    },
    {
      "start": 248.91,
      "end": 251.91,
      "text": "底下呢可能略宽那么0.5毫米的样子"
    },
    {
      "start": 251.91,
      "end": 254.91,
      "text": "我自己觉得它的平占比还是很高的"
    },
    {
      "start": 254.91,
      "end": 257.91,
      "text": "额外多出来那么一点平占比的感觉"
    },
    {
      "start": 257.91,
      "end": 259.91,
      "text": "毫无疑问呢 就是在这块屏幕上面"
    },
    {
      "start": 259.91,
      "end": 263.91,
      "text": "你看不到挖孔啊 这是最重要的一点"
    },
    {
      "start": 263.91,
      "end": 266.91,
      "text": "从上方往下滑 每一个过程"
    },
    {
      "start": 266.91,
      "end": 270.91,
      "text": "你都可以看到它挖孔部分去掉之后的一个整个的影响"
    },
    {
      "start": 270.91,
      "end": 273.91,
      "text": "有没有挖孔啊 这个颜值的变化真的是太大了"
    },
    {
      "start": 273.91,
      "end": 275.91,
      "text": "好 一会儿我们来看细节"
    },
    {
      "start": 275.91,
      "end": 277.91,
      "text": "大家不要着急 咱们先看整体的这个观感"
    },
    {
      "start": 277.91,
      "end": 280.91,
      "text": "我们再注意边缘这个位置啊 是有一个很小的这个R9"
    },
    {
      "start": 280.91,
      "end": 283.91,
      "text": "也就是说远看很硬了 近看呢或者摸起来的时候呢"
    },
    {
      "start": 283.91,
      "end": 285.91,
      "text": "在边缘这个位置是有过度的"
    },
    {
      "start": 285.91,
      "end": 288.91,
      "text": "而且在里面屏幕边缘这个位置也是有过度的"
    },
    {
      "start": 288.91,
      "end": 290.91,
      "text": "另外呢我们注意到它屏幕的弧度这里"
    },
    {
      "start": 290.91,
      "end": 293.91,
      "text": "你可以从侧边看到啊 它的弧度呢其实是比较小的"
    },
    {
      "start": 293.91,
      "end": 296.91,
      "text": "那么也就是说它更多的是为手感来服务"
    },
    {
      "start": 296.91,
      "end": 299.91,
      "text": "有对比才能知道它的平占比的一个情况"
    },
    {
      "start": 299.91,
      "end": 301.91,
      "text": "这边应该是非常的清楚"
    },
    {
      "start": 301.91,
      "end": 305.91,
      "text": "那中兴这台其实两边收窄也是比较明显"
    },
    {
      "start": 305.91,
      "end": 309.91,
      "text": "包括我们看到这个下巴的部分和iPhone来做对比"
    },
    {
      "start": 309.91,
      "end": 312.91,
      "text": "可以说是一眼的差距 在上方这里同样如此"
    },
    {
      "start": 312.91,
      "end": 316.91,
      "text": "那不客气的说啊 如果呢你喜欢一个完整的屏幕"
    },
    {
      "start": 316.91,
      "end": 320.91,
      "text": "那么这台机器呢应该就是目前你市面上需要重点观摩的"
    },
    {
      "start": 320.91,
      "end": 322.91,
      "text": "极端的硬朗 同时呢没滑孔"
    },
    {
      "start": 322.91,
      "end": 324.91,
      "text": "在这个位置啊到底能不能看得出来"
    },
    {
      "start": 324.91,
      "end": 327.91,
      "text": "首先我们要说一点啊 当我们熄灭屏幕的时候"
    },
    {
      "start": 327.91,
      "end": 330.91,
      "text": "你会发现这里明显会有一个孔位"
    },
    {
      "start": 330.91,
      "end": 333.91,
      "text": "这其实是屏幕贴膜 当我们撕掉它的时候"
    },
    {
      "start": 333.91,
      "end": 335.91,
      "text": "这里就没有了啊 当然为了保护屏幕"
    },
    {
      "start": 335.91,
      "end": 338.91,
      "text": "肯定是有原厂贴膜的 当我们点亮屏幕的时候"
    },
    {
      "start": 338.91,
      "end": 341.91,
      "text": "几乎是看不出来的 大家可以看一下啊"
    },
    {
      "start": 341.91,
      "end": 344.91,
      "text": "我现在已经是离到我们这个相机非常的近了"
    },
    {
      "start": 344.91,
      "end": 347.91,
      "text": "有这个贴膜 我觉得这个位置是有摄像头的"
    },
    {
      "start": 347.91,
      "end": 352.91,
      "text": "如果没有这个贴膜 我觉得这个位置真的是相当的完美了"
    },
    {
      "start": 352.91,
      "end": 356.91,
      "text": "当熄灭屏幕的时候 这个贴膜呢反倒会让我们觉得很明显"
    },
    {
      "start": 356.91,
      "end": 360.91,
      "text": "对吧 浅色还行 那别的颜色怎么样呢"
    },
    {
      "start": 360.91,
      "end": 362.91,
      "text": "这里是橘黄色的一个背景"
    },
    {
      "start": 362.91,
      "end": 364.91,
      "text": "蓝色的背景 那就更什么都看不出来了 是不是"
    },
    {
      "start": 364.91,
      "end": 367.91,
      "text": "应该说还是控制的比较的完美"
    },
    {
      "start": 367.91,
      "end": 370.91,
      "text": "上方都是树 这是以前有挖孔的时候"
    },
    {
      "start": 370.91,
      "end": 373.91,
      "text": "喜欢这么采用 在不同的颜色的情况下"
    },
    {
      "start": 373.91,
      "end": 375.91,
      "text": "怎么样 它的显示效果"
    },
    {
      "start": 375.91,
      "end": 378.91,
      "text": "想要找出遗憾都比较困难"
    },
    {
      "start": 378.91,
      "end": 380.91,
      "text": "好 拿出显微镜"
    },
    {
      "start": 380.91,
      "end": 382.91,
      "text": "那么这边非常的明显啊"
    },
    {
      "start": 382.91,
      "end": 384.91,
      "text": "是我们比较熟悉的这种类"
    },
    {
      "start": 384.91,
      "end": 386.91,
      "text": "或者是钻石类型的这种排列"
    },
    {
      "start": 386.91,
      "end": 389.91,
      "text": "之前我们说屏下摄像头的屏幕的部分"
    },
    {
      "start": 389.91,
      "end": 391.91,
      "text": "为了照顾到摄像头的部分"
    },
    {
      "start": 391.91,
      "end": 393.91,
      "text": "通常会把亮度做的没有那么高"
    },
    {
      "start": 393.91,
      "end": 395.91,
      "text": "但是这台机器的话 亮度就非常的高了"
    },
    {
      "start": 395.91,
      "end": 398.91,
      "text": "接下来的话 咱们看一看这台机器的方方面面"
    },
    {
      "start": 398.91,
      "end": 401.91,
      "text": "后船方面 我们看到已经支持如此多的品牌"
    },
    {
      "start": 401.91,
      "end": 404.91,
      "text": "个性化里面你可以设置的选项也是比较丰富的"
    },
    {
      "start": 404.91,
      "end": 407.91,
      "text": "这就是买OS里面所有这些都是可以定制的"
    },
    {
      "start": 407.91,
      "end": 409.91,
      "text": "显示的部分 几个方面"
    },
    {
      "start": 409.91,
      "end": 413.91,
      "text": "第一个 阅读模式看手机时间太长的困扰的话"
    },
    {
      "start": 413.91,
      "end": 416.91,
      "text": "我的建议就是你把它切换到阅读模式"
    },
    {
      "start": 416.91,
      "end": 420.91,
      "text": "你会发现立刻看视频兴趣一下子就降下来了"
    },
    {
      "start": 420.91,
      "end": 424.91,
      "text": "比如说你可以指定某些网站上面是黑白的还是很方便的"
    },
    {
      "start": 424.91,
      "end": 428.91,
      "text": "刷新率部分60 120高刷新率不再过多赘述"
    },
    {
      "start": 428.91,
      "end": 432.91,
      "text": "顶部区域 这边明显这是全局设置"
    },
    {
      "start": 432.91,
      "end": 436.91,
      "text": "它是告诉你其他的机器这个选项还得需要"
    },
    {
      "start": 436.91,
      "end": 438.91,
      "text": "我们这台机器完全不用"
    },
    {
      "start": 438.91,
      "end": 440.91,
      "text": "这台机器是屏下摄像头"
    },
    {
      "start": 440.91,
      "end": 442.91,
      "text": "所以在这个位置有一个单独的选项"
    },
    {
      "start": 442.91,
      "end": 446.91,
      "text": "叫做前摄屏幕显示效果微调"
    },
    {
      "start": 446.91,
      "end": 448.91,
      "text": "我们点开它 在这里你可以看到"
    },
    {
      "start": 448.91,
      "end": 451.91,
      "text": "在不同的亮度的情况下"
    },
    {
      "start": 451.91,
      "end": 453.91,
      "text": "这个位置看到了吧"
    },
    {
      "start": 453.91,
      "end": 462.56,
      "text": "这次应该也是中兴在这台机器上引入的一套全新的技术"
    },
    {
      "start": 462.56,
      "end": 464.56,
      "text": "以前我们说的所谓的屏幕控光"
    },
    {
      "start": 464.56,
      "end": 468.56,
      "text": "是一套控制针对多个像素点来进行控制"
    },
    {
      "start": 468.56,
      "end": 471.56,
      "text": "但是这台机器是单个像素点控制"
    },
    {
      "start": 471.56,
      "end": 474.56,
      "text": "它可以精细到摄像头的像素的位置"
    },
    {
      "start": 474.56,
      "end": 478.56,
      "text": "你可以让这个位置显示你想要的效果"
    },
    {
      "start": 478.56,
      "end": 481.56,
      "text": "对吧 你们想挖口我也可以挖口"
    },
    {
      "start": 481.56,
      "end": 482.56,
      "text": "虽然那么说有点凡尔赛是吧"
    },
    {
      "start": 482.56,
      "end": 486.56,
      "text": "甚至可以针对单一的像素去调节它的颜色"
    },
    {
      "start": 486.56,
      "end": 489.56,
      "text": "我这不光挖孔 我还能挖成绿孔"
    },
    {
      "start": 489.56,
      "end": 491.56,
      "text": "我还能挖成蓝孔"
    },
    {
      "start": 491.56,
      "end": 494.56,
      "text": "行吧 这些小心思还是很好玩的"
    },
    {
      "start": 494.56,
      "end": 496.56,
      "text": "当然如果是我 没什么说的"
    },
    {
      "start": 496.56,
      "end": 498.56,
      "text": "我就是没挖孔"
    },
    {
      "start": 498.56,
      "end": 501.56,
      "text": "刚才我看到有很多同学弹幕想聊到说"
    },
    {
      "start": 501.56,
      "end": 505.56,
      "text": "能不能看一下它显示这个位置的屏幕排列"
    },
    {
      "start": 505.56,
      "end": 506.56,
      "text": "是什么样子"
    },
    {
      "start": 506.56,
      "end": 507.56,
      "text": "没问题 咱们一起来看一看"
    },
    {
      "start": 507.56,
      "end": 510.56,
      "text": "首先 常规的部分咱们已经看过了"
    },
    {
      "start": 510.56,
      "end": 512.56,
      "text": "记住这个外观的排列"
    },
    {
      "start": 512.56,
      "end": 514.56,
      "text": "接下来咱们为大家展示一下"
    },
    {
      "start": 514.56,
      "end": 516.56,
      "text": "屏下视线头区域的排列"
    },
    {
      "start": 516.56,
      "end": 518.56,
      "text": "好 在这里你可以看到"
    },
    {
      "start": 518.56,
      "end": 519.56,
      "text": "还是类钻石排列"
    },
    {
      "start": 519.56,
      "end": 523.56,
      "text": "但是似乎和刚才的稍微有一点差别"
    },
    {
      "start": 523.56,
      "end": 524.56,
      "text": "有什么差别呢"
    },
    {
      "start": 524.56,
      "end": 525.56,
      "text": "看不出来是吧"
    },
    {
      "start": 525.56,
      "end": 529.56,
      "text": "那我们不妨就把屏幕挖孔的区域"
    },
    {
      "start": 529.56,
      "end": 531.56,
      "text": "和屏幕显示的区域"
    },
    {
      "start": 531.56,
      "end": 533.56,
      "text": "放到一起来拍一张照片试试"
    },
    {
      "start": 533.56,
      "end": 534.56,
      "text": "这个有点困难啊"
    },
    {
      "start": 534.56,
      "end": 536.56,
      "text": "因为它这个区域非常的小"
    },
    {
      "start": 536.56,
      "end": 538.56,
      "text": "我尝试着找一找啊"
    },
    {
      "start": 538.56,
      "end": 540.56,
      "text": "好 不知道这样行不行啊"
    },
    {
      "start": 540.56,
      "end": 542.56,
      "text": "OK 来同学们啊"
    },
    {
      "start": 542.56,
      "end": 544.56,
      "text": "咱们下面一起来见证的就是"
    },
    {
      "start": 544.56,
      "end": 546.56,
      "text": "在这一个屏幕上面"
    },
    {
      "start": 546.56,
      "end": 549.56,
      "text": "你可以看到两种像素排列"
    },
    {
      "start": 549.56,
      "end": 552.56,
      "text": "下方的蓝色紫像素是类似方形的"
    },
    {
      "start": 552.56,
      "end": 555.56,
      "text": "上方的蓝色紫像素是类似圆形的"
    },
    {
      "start": 555.56,
      "end": 557.56,
      "text": "只有在显微镜下"
    },
    {
      "start": 557.56,
      "end": 559.56,
      "text": "我们还能看出如此的差别"
    },
    {
      "start": 559.56,
      "end": 561.56,
      "text": "但是这个差别已经非常的小了"
    },
    {
      "start": 561.56,
      "end": 563.56,
      "text": "也就是说我们肉眼去观看这个屏幕的时候"
    },
    {
      "start": 563.56,
      "end": 565.56,
      "text": "几乎已经看不出差别了"
    },
    {
      "start": 565.56,
      "end": 569.56,
      "text": "可以说全新升级的AXON40 Ultra的屏幕部分的表现"
    },
    {
      "start": 569.56,
      "end": 571.56,
      "text": "是超出我们的预期的"
    },
    {
      "start": 571.56,
      "end": 578.08,
      "text": "那对称的扬声器"
    },
    {
      "start": 578.08,
      "end": 586.93,
      "text": "灵溪助理侧边按钮这里"
    },
    {
      "start": 586.93,
      "end": 588.93,
      "text": "快速的调用一些程序"
    },
    {
      "start": 588.93,
      "end": 591.93,
      "text": "小窗我们可以通过分屏的方式"
    },
    {
      "start": 591.93,
      "end": 592.93,
      "text": "开启更多的程序"
    },
    {
      "start": 592.93,
      "end": 595.93,
      "text": "而且呢可以不同的程序去切换"
    },
    {
      "start": 595.93,
      "end": 598.93,
      "text": "来看一下它的屏幕指纹区域"
    },
    {
      "start": 598.93,
      "end": 600.93,
      "text": "那这台手机呢是比较我们自然的位置"
    },
    {
      "start": 600.93,
      "end": 601.93,
      "text": "指纹识别的样式"
    },
    {
      "start": 601.93,
      "end": 603.93,
      "text": "可以根据自己的需求来做定制"
    },
    {
      "start": 603.93,
      "end": 604.93,
      "text": "人脸识别"
    },
    {
      "start": 604.93,
      "end": 606.93,
      "text": "3 2 1"
    },
    {
      "start": 606.93,
      "end": 608.93,
      "text": "好 然后我们遮挡嘴巴"
    },
    {
      "start": 609.93,
      "end": 611.93,
      "text": "我们遮挡鼻子"
    },
    {
      "start": 611.93,
      "end": 613.93,
      "text": "好 还是可以啊"
    },
    {
      "start": 613.93,
      "end": 614.93,
      "text": "那目的非常简单"
    },
    {
      "start": 614.93,
      "end": 616.93,
      "text": "就是在我们戴口罩的时候"
    },
    {
      "start": 616.93,
      "end": 617.93,
      "text": "也要解锁"
    },
    {
      "start": 618.93,
      "end": 620.93,
      "text": "现在你看我所遮挡的面部"
    },
    {
      "start": 620.93,
      "end": 621.93,
      "text": "已经是比较多的了"
    },
    {
      "start": 621.93,
      "end": 623.93,
      "text": "嘴 鼻子 脸都没了"
    },
    {
      "start": 623.93,
      "end": 624.93,
      "text": "是吧"
    },
    {
      "start": 624.93,
      "end": 625.93,
      "text": "觉得能解锁打个1"
    },
    {
      "start": 625.93,
      "end": 626.93,
      "text": "觉得解不了打一盖"
    },
    {
      "start": 626.93,
      "end": 628.93,
      "text": "3 2 1"
    },
    {
      "start": 630.93,
      "end": 631.93,
      "text": "好 还是可以解锁"
    },
    {
      "start": 631.93,
      "end": 633.93,
      "text": "那接下来呢咱们看的是它的拍照的部分"
    },
    {
      "start": 633.93,
      "end": 635.93,
      "text": "在下方呢是有不少的选项"
    },
    {
      "start": 635.93,
      "end": 639.93,
      "text": "这里呢还有中型特色的相机家族"
    },
    {
      "start": 639.93,
      "end": 641.93,
      "text": "相机的部分呢是有一些特殊的亮点"
    },
    {
      "start": 641.93,
      "end": 645.93,
      "text": "首先呢是三摄都是6400万的高像素"
    },
    {
      "start": 645.93,
      "end": 647.93,
      "text": "然后我们来看一下里面可设置的选项"
    },
    {
      "start": 647.93,
      "end": 649.93,
      "text": "人脸识别 人眼识别"
    },
    {
      "start": 649.93,
      "end": 650.93,
      "text": "根据眼睛这块"
    },
    {
      "start": 650.93,
      "end": 652.93,
      "text": "防抖效果增强等等"
    },
    {
      "start": 652.93,
      "end": 656.93,
      "text": "视频选项这里我们可以看到超高清8K"
    },
    {
      "start": 656.93,
      "end": 659.93,
      "text": "这是最高的可以支持8K四频的拍摄"
    },
    {
      "start": 659.93,
      "end": 661.93,
      "text": "同时呢下面有4K"
    },
    {
      "start": 661.93,
      "end": 662.93,
      "text": "60帧和"
    },
    {
      "start": 662.93,
      "end": 664.93,
      "text": "据夸张的4K"
    },
    {
      "start": 664.93,
      "end": 665.93,
      "text": "120帧"
    },
    {
      "start": 665.93,
      "end": 667.93,
      "text": "这在市面上是极其罕见的"
    },
    {
      "start": 667.93,
      "end": 670.93,
      "text": "当我们去户外呢拍摄一些比较重要的场景的时候"
    },
    {
      "start": 670.93,
      "end": 675.93,
      "text": "高震率和高分辨率同时获取并不容易"
    },
    {
      "start": 675.93,
      "end": 676.93,
      "text": "还有一个小的功能啊"
    },
    {
      "start": 676.93,
      "end": 678.93,
      "text": "就是适合我们在户外抓拍"
    },
    {
      "start": 678.93,
      "end": 682.93,
      "text": "吸屏状态下双击音量键可以完成拍照"
    },
    {
      "start": 682.93,
      "end": 685.93,
      "text": "就比较适合我们去户外啊遇到一些极端特殊的情况啊"
    },
    {
      "start": 685.93,
      "end": 689.93,
      "text": "需要拍摄的时候只需要点击两下侧边的这个按钮"
    },
    {
      "start": 689.93,
      "end": 690.93,
      "text": "就已经拍摄完毕"
    },
    {
      "start": 690.93,
      "end": 692.93,
      "text": "并且呢当你每拍摄一张的时候呢"
    },
    {
      "start": 692.93,
      "end": 694.93,
      "text": "它会拍摄三张照片"
    },
    {
      "start": 694.93,
      "end": 696.93,
      "text": "一张呢是常规曝光的"
    },
    {
      "start": 696.93,
      "end": 697.93,
      "text": "一张呢是低曝光"
    },
    {
      "start": 697.93,
      "end": 699.93,
      "text": "一张呢是过多曝光的"
    },
    {
      "start": 699.93,
      "end": 700.93,
      "text": "提高你拍摄的成功率"
    },
    {
      "start": 700.93,
      "end": 702.93,
      "text": "那这里还有一个比较特殊的"
    },
    {
      "start": 702.93,
      "end": 704.93,
      "text": "这边是超高清8K视频"
    },
    {
      "start": 704.93,
      "end": 709.93,
      "text": "我们现在在广角一倍变焦和长焦端三美镜头组的情况下"
    },
    {
      "start": 709.93,
      "end": 711.93,
      "text": "都能进行8K视频的拍摄"
    },
    {
      "start": 711.93,
      "end": 714.93,
      "text": "这个能力是非常强悍"
    },
    {
      "start": 714.93,
      "end": 715.93,
      "text": "另外呢在录像的时候"
    },
    {
      "start": 715.93,
      "end": 717.93,
      "text": "这边你可以去选择麦克风"
    },
    {
      "start": 717.93,
      "end": 719.93,
      "text": "这边你可以选择前置录音"
    },
    {
      "start": 719.93,
      "end": 722.93,
      "text": "也可以选择后置录音在这个位置"
    },
    {
      "start": 722.93,
      "end": 724.93,
      "text": "还可以选择全景录音"
    },
    {
      "start": 724.93,
      "end": 725.93,
      "text": "夜景部分也是完整支持"
    },
    {
      "start": 725.93,
      "end": 728.93,
      "text": "专门有一枚35毫米的人像镜头"
    },
    {
      "start": 728.93,
      "end": 731.93,
      "text": "人文街拍这里对于街拍来说很重要"
    },
    {
      "start": 731.93,
      "end": 733.93,
      "text": "我们知道啊扫街最重要的呢"
    },
    {
      "start": 733.93,
      "end": 734.93,
      "text": "就怕对不上焦"
    },
    {
      "start": 734.93,
      "end": 737.93,
      "text": "它增加了一个叫做自动对焦的人文街拍"
    },
    {
      "start": 737.93,
      "end": 738.93,
      "text": "预对焦模式"
    },
    {
      "start": 738.93,
      "end": 739.93,
      "text": "那么开启之后的话呢"
    },
    {
      "start": 739.93,
      "end": 741.93,
      "text": "就可以变成全局对焦"
    },
    {
      "start": 741.93,
      "end": 743.93,
      "text": "而且在扫街的时候"
    },
    {
      "start": 743.93,
      "end": 744.93,
      "text": "这里还有一个胶片模式"
    },
    {
      "start": 744.93,
      "end": 748.93,
      "text": "而且这边呢还有一个水平仪整合到了快门当中"
    },
    {
      "start": 748.93,
      "end": 750.93,
      "text": "回到前摄这里"
    },
    {
      "start": 750.93,
      "end": 752.93,
      "text": "屏下摄像头要想解决拍照"
    },
    {
      "start": 752.93,
      "end": 753.93,
      "text": "又想解决显示"
    },
    {
      "start": 753.93,
      "end": 755.93,
      "text": "其实都不是太容易"
    },
    {
      "start": 755.93,
      "end": 756.93,
      "text": "好"
    },
    {
      "start": 756.93,
      "end": 758.93,
      "text": "我就是这么随便拍了一张啊"
    },
    {
      "start": 758.93,
      "end": 759.93,
      "text": "大家可以大致的来感受一下"
    },
    {
      "start": 759.93,
      "end": 762.93,
      "text": "毛发的部分是不是足够多的细节"
    },
    {
      "start": 762.93,
      "end": 765.93,
      "text": "那么这个效果不知道大家觉得怎么样呢"
    },
    {
      "start": 765.93,
      "end": 766.93,
      "text": "好"
    },
    {
      "start": 766.93,
      "end": 768.93,
      "text": "这次呢拍照部分呢还有一个重点呢"
    },
    {
      "start": 768.93,
      "end": 772.93,
      "text": "就是中兴最近这一两年一直在力推的功能叫做多摄同拍"
    },
    {
      "start": 772.93,
      "end": 775.93,
      "text": "就是后面这三枚镜头在拍摄的时候呢"
    },
    {
      "start": 775.93,
      "end": 776.93,
      "text": "获得同样的效果"
    },
    {
      "start": 776.93,
      "end": 778.93,
      "text": "除了一个预览框之外"
    },
    {
      "start": 778.93,
      "end": 782.93,
      "text": "那么在下方呢还有广角和长焦两个预览框在这里"
    },
    {
      "start": 782.93,
      "end": 783.93,
      "text": "就是你拍一次的时候呢"
    },
    {
      "start": 783.93,
      "end": 786.93,
      "text": "这三个镜头是同时工作的"
    },
    {
      "start": 786.93,
      "end": 788.93,
      "text": "比如说我拍我旁边这有一盆花"
    },
    {
      "start": 788.93,
      "end": 790.93,
      "text": "那么回到这个位置"
    },
    {
      "start": 790.93,
      "end": 792.93,
      "text": "大家看到这是这个花盆"
    },
    {
      "start": 792.93,
      "end": 794.93,
      "text": "但是呢我们可以通过变焦的方式"
    },
    {
      "start": 794.93,
      "end": 797.93,
      "text": "获得它广角端"
    },
    {
      "start": 797.93,
      "end": 799.93,
      "text": "那么回到一倍变焦"
    },
    {
      "start": 799.93,
      "end": 800.93,
      "text": "长焦"
    },
    {
      "start": 800.93,
      "end": 801.93,
      "text": "放大的细节"
    },
    {
      "start": 801.93,
      "end": 802.93,
      "text": "注意啊"
    },
    {
      "start": 802.93,
      "end": 803.93,
      "text": "这个放大的细节呢"
    },
    {
      "start": 803.93,
      "end": 804.93,
      "text": "是全像素放大的细节"
    },
    {
      "start": 804.93,
      "end": 807.93,
      "text": "甚至呢我们还可以再放大"
    },
    {
      "start": 807.93,
      "end": 808.93,
      "text": "是吧"
    },
    {
      "start": 808.93,
      "end": 811.93,
      "text": "这就是多摄同拍的能力"
    },
    {
      "start": 811.93,
      "end": 814.93,
      "text": "这里呢还有多摄同拍录像"
    },
    {
      "start": 814.93,
      "end": 815.93,
      "text": "在这个位置"
    },
    {
      "start": 815.93,
      "end": 816.93,
      "text": "对吧"
    },
    {
      "start": 816.93,
      "end": 817.93,
      "text": "我们点完之后"
    },
    {
      "start": 817.93,
      "end": 818.93,
      "text": "大家看到这里有"
    },
    {
      "start": 818.93,
      "end": 819.93,
      "text": "一二三四五六"
    },
    {
      "start": 819.93,
      "end": 821.93,
      "text": "六个取景器"
    },
    {
      "start": 821.93,
      "end": 824.93,
      "text": "经常啊就是又想给你家宝宝来个特写"
    },
    {
      "start": 824.93,
      "end": 827.93,
      "text": "但是呢又想给全场景拍个大场景"
    },
    {
      "start": 827.93,
      "end": 830.93,
      "text": "这个时候多摄同录就非常重要了"
    },
    {
      "start": 830.93,
      "end": 831.93,
      "text": "大家看到我们在录像的时候"
    },
    {
      "start": 831.93,
      "end": 834.93,
      "text": "可以选一二三三个镜头组最终来入镜"
    },
    {
      "start": 834.93,
      "end": 836.93,
      "text": "而且呢在录制的时候呢"
    },
    {
      "start": 836.93,
      "end": 840.93,
      "text": "你还可以去选择出来的这个最终这个画面"
    },
    {
      "start": 840.93,
      "end": 842.93,
      "text": "这是录全景啊"
    },
    {
      "start": 842.93,
      "end": 843.93,
      "text": "比如三个小朋友在跳舞"
    },
    {
      "start": 843.93,
      "end": 845.93,
      "text": "然后这是录中间这个05的特写"
    },
    {
      "start": 845.93,
      "end": 847.93,
      "text": "然后这是录导演我本人"
    },
    {
      "start": 847.93,
      "end": 848.93,
      "text": "而且这三个画面呢"
    },
    {
      "start": 848.93,
      "end": 850.93,
      "text": "和可以在录的过程当中"
    },
    {
      "start": 850.93,
      "end": 851.93,
      "text": "你不停的去换位置"
    },
    {
      "start": 851.93,
      "end": 852.93,
      "text": "是吧"
    },
    {
      "start": 852.93,
      "end": 854.93,
      "text": "让你当一个导演的过过瘾"
    },
    {
      "start": 854.93,
      "end": 855.93,
      "text": "OK"
    },
    {
      "start": 855.93,
      "end": 856.93,
      "text": "那么看到这里呢"
    },
    {
      "start": 856.93,
      "end": 859.93,
      "text": "这就是这台中兴的AXON40 Ultra"
    },
    {
      "start": 859.93,
      "end": 861.93,
      "text": "我觉得最重要的两个方面"
    },
    {
      "start": 861.93,
      "end": 862.93,
      "text": "第一个屏幕"
    },
    {
      "start": 862.93,
      "end": 865.93,
      "text": "这款呢屏下摄像头的这个表现"
    },
    {
      "start": 865.93,
      "end": 869.93,
      "text": "我觉得已经趋近于我们想要的那个完美的效果"
    },
    {
      "start": 869.93,
      "end": 871.93,
      "text": "而且大家可以有印象啊"
    },
    {
      "start": 871.93,
      "end": 872.93,
      "text": "之前咱们看到这个位置呢"
    },
    {
      "start": 872.93,
      "end": 874.93,
      "text": "经常是在高亮的情况下"
    },
    {
      "start": 874.93,
      "end": 875.93,
      "text": "它会露馅"
    },
    {
      "start": 875.93,
      "end": 876.93,
      "text": "我们看看这台机器呢"
    },
    {
      "start": 876.93,
      "end": 877.93,
      "text": "你可以看到啊"
    },
    {
      "start": 877.93,
      "end": 878.93,
      "text": "反正我用肉眼看的话呢"
    },
    {
      "start": 878.93,
      "end": 881.93,
      "text": "是很难看到以前那个明显的阴影的部分"
    },
    {
      "start": 881.93,
      "end": 883.93,
      "text": "这是它的屏幕部分"
    },
    {
      "start": 883.93,
      "end": 884.93,
      "text": "我觉得还是很厉害的"
    },
    {
      "start": 884.93,
      "end": 886.93,
      "text": "然后呢就是它的拍照的部分"
    },
    {
      "start": 886.93,
      "end": 887.93,
      "text": "也很有特色"
    },
    {
      "start": 887.93,
      "end": 890.93,
      "text": "三枚镜头呢想要做到多摄同拍的效果"
    },
    {
      "start": 890.93,
      "end": 893.93,
      "text": "而且呢是两枚索尼的MX787"
    },
    {
      "start": 893.93,
      "end": 895.93,
      "text": "外加一枚潜望镜头"
    },
    {
      "start": 895.93,
      "end": 897.93,
      "text": "OK 那么这台中兴的AXON40 Ultra"
    },
    {
      "start": 897.93,
      "end": 898.93,
      "text": "我们就为大家开箱到这里"
    },
    {
      "start": 898.93,
      "end": 900.93,
      "text": "大家可以满分"
    },
    {
      "start": 900.93,
      "end": 902.93,
      "text": "十分的情况下给它打一个分数"
    },
    {
      "start": 902.93,
      "end": 904.93,
      "text": "你觉得这台机器是否符合你的预期呢"
    },
    {
      "start": 904.93,
      "end": 905.93,
      "text": "咱就放开了吧"
    },
    {
      "start": 905.93,
      "end": 907.93,
      "text": "咱就把它撕了行不行"
    },
    {
      "start": 907.93,
      "end": 908.93,
      "text": "哎呀"
    },
    {
      "start": 908.93,
      "end": 909.93,
      "text": "我跟大家说一下啊"
    },
    {
      "start": 909.93,
      "end": 911.93,
      "text": "咱们这是科技美学的直播间啊"
    },
    {
      "start": 911.93,
      "end": 913.93,
      "text": "咱们不要轻易模仿啊"
    },
    {
      "start": 913.93,
      "end": 914.93,
      "text": "就是你们自己买了的话"
    },
    {
      "start": 914.93,
      "end": 915.93,
      "text": "不要像我这样啊"
    },
    {
      "start": 915.93,
      "end": 918.93,
      "text": "我是看的这个总是有同学说你这个挖孔太明显"
    },
    {
      "start": 918.93,
      "end": 921.93,
      "text": "我今天就让你看看它到底有多明显"
    },
    {
      "start": 921.93,
      "end": 928.41,
      "text": "我看谁还说明显"
    },
    {
      "start": 928.41,
      "end": 929.41,
      "text": "怎么样"
    },
    {
      "start": 929.41,
      "end": 932.41,
      "text": "这回没有贴膜影响了吧"
    },
    {
      "start": 932.41,
      "end": 936.41,
      "text": "是不是非常难以看出它是有摄像头的"
    },
    {
      "start": 936.41,
      "end": 937.41,
      "text": "很多时候啊"
    },
    {
      "start": 937.41,
      "end": 940.41,
      "text": "这个技术的投入这个钱是真的不白花"
    },
    {
      "start": 940.41,
      "end": 941.41,
      "text": "OK"
    },
    {
      "start": 941.41,
      "end": 942.41,
      "text": "这就是科技美学的直播间"
    },
    {
      "start": 942.41,
      "end": 944.41,
      "text": "感谢大家来看我们的直播"
    },
    {
      "start": 944.41,
      "end": 945.41,
      "text": "关于它的详细测试呢"
    },
    {
      "start": 945.41,
      "end": 948.41,
      "text": "请大家期待我们后续的内容"
    },
    {
      "start": 948.41,
      "end": 949.41,
      "text": "我们详细测试"
    },
    {
      "start": 949.41,
      "end": 950.41,
      "text": "再见"
    },
    {
      "start": 950.41,
      "end": 953.41,
      "text": "白虾我这个贴膜了"
    },
    {
      "start": 953.41,
      "end": 954.41,
      "text": "哎呀"
    },
    {
      "start": 954.41,
      "end": 956.41,
      "text": "这么完美的贴膜"
    },
    {
      "start": 956.41,
      "end": 960.33,
      "text": "它上面是没有这个挖孔就好了"
    },
    {
      "start": 960.33,
      "end": 962.33,
      "text": "那我把这个贴膜给它倒着贴不就完了吗"
    },
    {
      "start": 962.33,
      "end": 965.87,
      "text": "完了完整了"
    },
    {
      "start": 965.87,
      "end": 966.87,
      "text": "我就是反面例子啊"
    },
    {
      "start": 966.87,
      "end": 968.87,
      "text": "大家千万不要像我学习"
    },
    {
      "start": 968.87,
      "end": 969.87,
      "text": "把这个撕下来"
    },
    {
      "start": 969.87,
      "end": 970.87,
      "text": "撕下来太可惜了"
    },
    {
      "start": 970.87,
      "end": 971.87,
      "text": "这个贴膜本身很好"
    },
    {
      "start": 971.87,
      "end": 972.87,
      "text": "另外呢"
    },
    {
      "start": 972.87,
      "end": 974.87,
      "text": "要是没这个挖孔可能就更好"
    },
    {
      "start": 974.87,
      "end": 979.87,
      "text": "总之就是睡台让人觉得屏幕真的很完美的机器"
    },
    {
      "start": 979.87,
      "end": 980.87,
      "text": "很精致"
    },
    {
      "start": 980.87,
      "end": 981.87,
      "text": "没有遗憾"
    },
    {
      "start": 981.87,
      "end": 982.87,
      "text": "好"
    },
    {
      "start": 982.87,
      "end": 983.87,
      "text": "好"
    },
    {
      "start": 983.87,
      "end": 984.87,
      "text": "好"
    },
    {
      "start": 984.87,
      "end": 985.87,
      "text": "好"
    }
  ]
}
