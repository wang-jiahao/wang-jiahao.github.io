{
  "media": "../../media/source.mp4",
  "requested_range": [
    240.0,
    580.0
  ],
  "model": "small",
  "engine": "faster-whisper/local CPU; no cloud media service",
  "language": "zh",
  "language_probability": 1,
  "segments": [
    {
      "start": 240.0,
      "end": 242.16,
      "text": "不知道大家的第一印象怎么样"
    },
    {
      "start": 242.16,
      "end": 244.6,
      "text": "从我个人的角度来看的话"
    },
    {
      "start": 244.6,
      "end": 246.96,
      "text": "它的两边的边框是比较窄的"
    },
    {
      "start": 246.96,
      "end": 250.0,
      "text": "那么上下部分基本上算是等宽"
    },
    {
      "start": 250.0,
      "end": 252.72,
      "text": "底下可能略宽那么0.5毫米的样子"
    },
    {
      "start": 252.72,
      "end": 255.6,
      "text": "我自己觉得它的平占比还是很高的"
    },
    {
      "start": 255.6,
      "end": 258.44,
      "text": "额外多出来那么一点平占比的感觉"
    },
    {
      "start": 258.44,
      "end": 260.68,
      "text": "毫无疑问的就是在这块屏幕上面"
    },
    {
      "start": 260.68,
      "end": 262.84,
      "text": "你看不到挖孔"
    },
    {
      "start": 262.84,
      "end": 264.52,
      "text": "这是最重要的一点"
    },
    {
      "start": 264.52,
      "end": 266.36,
      "text": "从上方往下滑"
    },
    {
      "start": 266.36,
      "end": 268.28,
      "text": "每一个过程你都可以看到"
    },
    {
      "start": 268.28,
      "end": 271.48,
      "text": "它挖孔部分去掉之后的一个整个的影响"
    },
    {
      "start": 271.48,
      "end": 272.64,
      "text": "有没有挖孔"
    },
    {
      "start": 272.64,
      "end": 274.6,
      "text": "延迟的变化真的是太大了"
    },
    {
      "start": 274.6,
      "end": 276.08,
      "text": "好 一会我们来看细节"
    },
    {
      "start": 276.08,
      "end": 276.88,
      "text": "大家不要着急"
    },
    {
      "start": 276.88,
      "end": 278.44,
      "text": "咱们先看整体的这个观感"
    },
    {
      "start": 278.44,
      "end": 279.72,
      "text": "我们再注意边缘这个位置"
    },
    {
      "start": 279.72,
      "end": 281.24,
      "text": "是有一个很小的这个耳脚"
    },
    {
      "start": 281.24,
      "end": 282.92,
      "text": "也就是说远看很硬了"
    },
    {
      "start": 282.92,
      "end": 284.44,
      "text": "近看或者摸起来的时候"
    },
    {
      "start": 284.44,
      "end": 286.2,
      "text": "在边缘这个位置是有过度的"
    },
    {
      "start": 286.2,
      "end": 288.0,
      "text": "而且在里面屏幕边缘这个位置"
    },
    {
      "start": 288.0,
      "end": 289.16,
      "text": "也是有过度的"
    },
    {
      "start": 289.16,
      "end": 291.4,
      "text": "另外我们注意到它屏幕的弧度这里"
    },
    {
      "start": 291.4,
      "end": 292.68,
      "text": "你可以从侧边看到"
    },
    {
      "start": 292.68,
      "end": 294.64,
      "text": "它的弧度其实是比较小的"
    },
    {
      "start": 294.64,
      "end": 297.96,
      "text": "那么也就是说它更多的是为手感来浮"
    },
    {
      "start": 297.96,
      "end": 300.84,
      "text": "有对比才能知道它的屏占北的一个情况"
    },
    {
      "start": 300.84,
      "end": 303.08,
      "text": "这边应该是非常的清楚"
    },
    {
      "start": 303.08,
      "end": 306.64,
      "text": "中心这台其实两边收窄也是比较明显"
    },
    {
      "start": 306.64,
      "end": 310.48,
      "text": "包括我们看到下巴的部分和iPhone来做对比"
    },
    {
      "start": 310.48,
      "end": 312.16,
      "text": "可以说是一眼的差距"
    },
    {
      "start": 312.16,
      "end": 313.88,
      "text": "在上方这里同样如此"
    },
    {
      "start": 313.88,
      "end": 315.16,
      "text": "不客气的说"
    },
    {
      "start": 315.16,
      "end": 317.48,
      "text": "如果你喜欢一个完整的屏幕"
    },
    {
      "start": 317.48,
      "end": 319.0,
      "text": "那么这台机器应该就是"
    },
    {
      "start": 319.0,
      "end": 321.4,
      "text": "目前你市面上需要重点观摩的"
    },
    {
      "start": 321.4,
      "end": 323.6,
      "text": "极端的硬脑同时没有挖孔"
    },
    {
      "start": 323.6,
      "end": 326.04,
      "text": "在这个位置到底能不能看得出来"
    },
    {
      "start": 326.04,
      "end": 327.6,
      "text": "首先我们要说一点"
    },
    {
      "start": 327.6,
      "end": 329.12,
      "text": "当我们熄灭屏幕的时候"
    },
    {
      "start": 329.12,
      "end": 332.08,
      "text": "你会发现这里明显会有一个孔位"
    },
    {
      "start": 332.08,
      "end": 333.72,
      "text": "这其实是屏幕贴膜"
    },
    {
      "start": 333.72,
      "end": 335.76,
      "text": "当我们撕掉它的时候这里就没有了"
    },
    {
      "start": 335.76,
      "end": 338.08,
      "text": "当然为了保护屏幕肯定是有原厂贴膜的"
    },
    {
      "start": 338.08,
      "end": 341.44,
      "text": "当我们点亮屏幕的时候几乎是看不出来"
    },
    {
      "start": 341.44,
      "end": 342.28,
      "text": "大家可以看一下"
    },
    {
      "start": 342.28,
      "end": 345.64,
      "text": "我现在已经是离得我们的相机非常的近了"
    },
    {
      "start": 345.64,
      "end": 346.72,
      "text": "有这个贴膜"
    },
    {
      "start": 346.72,
      "end": 348.92,
      "text": "我觉得这个位置是有摄像头的"
    },
    {
      "start": 348.92,
      "end": 350.72,
      "text": "如果没有这个贴膜"
    },
    {
      "start": 350.72,
      "end": 354.28,
      "text": "我觉得这个位置真的是相当的完美了"
    },
    {
      "start": 354.28,
      "end": 355.72,
      "text": "当熄灭屏幕的时候"
    },
    {
      "start": 355.72,
      "end": 358.24,
      "text": "这个贴膜反倒会让我们觉得很明显"
    },
    {
      "start": 358.24,
      "end": 358.72,
      "text": "对吧"
    },
    {
      "start": 358.72,
      "end": 360.04,
      "text": "浅色还行"
    },
    {
      "start": 360.04,
      "end": 361.16,
      "text": "别的颜色怎么样"
    },
    {
      "start": 361.16,
      "end": 363.52,
      "text": "这里是橘黄色的一个背景"
    },
    {
      "start": 363.52,
      "end": 364.32,
      "text": "蓝色的背景"
    },
    {
      "start": 364.32,
      "end": 365.8,
      "text": "那就更什么都看不出来了"
    },
    {
      "start": 365.8,
      "end": 368.36,
      "text": "应该说还是控制的比较的完美"
    },
    {
      "start": 368.36,
      "end": 369.56,
      "text": "上方都是树"
    },
    {
      "start": 369.56,
      "end": 371.72,
      "text": "这是以前有挖孔的时候"
    },
    {
      "start": 371.72,
      "end": 372.96,
      "text": "喜欢这么采用"
    },
    {
      "start": 372.96,
      "end": 374.8,
      "text": "在不同的颜色的情况下"
    },
    {
      "start": 374.8,
      "end": 375.28,
      "text": "怎么样"
    },
    {
      "start": 375.28,
      "end": 376.52,
      "text": "它的显示效果"
    },
    {
      "start": 376.52,
      "end": 377.88,
      "text": "想要找出遗憾"
    },
    {
      "start": 377.88,
      "end": 379.0,
      "text": "都比较困难"
    },
    {
      "start": 379.0,
      "end": 379.32,
      "text": "好"
    },
    {
      "start": 379.32,
      "end": 380.92,
      "text": "我们拿出显微镜"
    },
    {
      "start": 381.92,
      "end": 383.32,
      "text": "那么这边非常的明显"
    },
    {
      "start": 383.32,
      "end": 385.12,
      "text": "是我们比较熟悉的这种"
    },
    {
      "start": 385.16,
      "end": 385.64,
      "text": "类"
    },
    {
      "start": 385.64,
      "end": 387.48,
      "text": "或者是钻石类型的这种排列"
    },
    {
      "start": 387.48,
      "end": 390.32,
      "text": "之前我们说屏下摄像头的屏幕的部分"
    },
    {
      "start": 390.32,
      "end": 392.56,
      "text": "为了照顾到摄像头的部分"
    },
    {
      "start": 392.56,
      "end": 394.64,
      "text": "通常会把亮度做的没有那么高"
    },
    {
      "start": 394.64,
      "end": 395.52,
      "text": "但是这台机器的话"
    },
    {
      "start": 395.52,
      "end": 396.96,
      "text": "亮度就非常的高了"
    },
    {
      "start": 396.96,
      "end": 397.56,
      "text": "接下来的话"
    },
    {
      "start": 397.56,
      "end": 400.16,
      "text": "咱们看一看这台机器的方方面面"
    },
    {
      "start": 400.16,
      "end": 400.88,
      "text": "后传的方面"
    },
    {
      "start": 400.88,
      "end": 403.12,
      "text": "我们看到已经支持如此多的品牌"
    },
    {
      "start": 403.12,
      "end": 403.8,
      "text": "个性化里面"
    },
    {
      "start": 403.8,
      "end": 406.04,
      "text": "你可以设置的选项也是比较丰富的"
    },
    {
      "start": 406.04,
      "end": 407.44,
      "text": "这就是买OS里面"
    },
    {
      "start": 407.44,
      "end": 409.2,
      "text": "所有这些都是可以定制的"
    },
    {
      "start": 409.2,
      "end": 410.0,
      "text": "显示的部分"
    },
    {
      "start": 410.0,
      "end": 410.76,
      "text": "几个方面"
    },
    {
      "start": 410.76,
      "end": 411.28,
      "text": "第一个"
    },
    {
      "start": 411.28,
      "end": 414.36,
      "text": "阅读模式看手机时间太长的困扰的话"
    },
    {
      "start": 414.4,
      "end": 415.12,
      "text": "我的建议就是"
    },
    {
      "start": 415.12,
      "end": 417.48,
      "text": "你把它切换到阅读模式"
    },
    {
      "start": 417.48,
      "end": 418.88,
      "text": "你会发现立刻"
    },
    {
      "start": 418.88,
      "end": 419.96,
      "text": "看视频"
    },
    {
      "start": 419.96,
      "end": 421.28,
      "text": "兴趣一下子就降下来了"
    },
    {
      "start": 421.28,
      "end": 422.84,
      "text": "比如说你可以指定"
    },
    {
      "start": 422.84,
      "end": 424.84,
      "text": "某些网站上面是黑白的"
    },
    {
      "start": 424.84,
      "end": 425.8,
      "text": "还是很方便"
    },
    {
      "start": 425.8,
      "end": 426.52,
      "text": "刷新率部分"
    },
    {
      "start": 426.52,
      "end": 427.64,
      "text": "60 120"
    },
    {
      "start": 427.64,
      "end": 428.32,
      "text": "高刷新率"
    },
    {
      "start": 428.32,
      "end": 429.4,
      "text": "不再过多坠述"
    },
    {
      "start": 429.4,
      "end": 430.32,
      "text": "顶部区域"
    },
    {
      "start": 430.32,
      "end": 430.84,
      "text": "哦"
    },
    {
      "start": 430.84,
      "end": 432.12,
      "text": "这边明显"
    },
    {
      "start": 432.12,
      "end": 433.68,
      "text": "这是全局设置"
    },
    {
      "start": 433.68,
      "end": 434.64,
      "text": "它是告诉你"
    },
    {
      "start": 434.64,
      "end": 435.6,
      "text": "其他的机器"
    },
    {
      "start": 435.6,
      "end": 437.32,
      "text": "这个选项还得需要"
    },
    {
      "start": 437.32,
      "end": 439.36,
      "text": "我们这台机器完全不用"
    },
    {
      "start": 439.36,
      "end": 441.16,
      "text": "这台机器是屏下摄像头"
    },
    {
      "start": 441.16,
      "end": 442.28,
      "text": "所以在这个位置"
    },
    {
      "start": 442.28,
      "end": 443.64,
      "text": "有一个单独的选项"
    },
    {
      "start": 443.64,
      "end": 445.36,
      "text": "叫做前摄屏幕"
    },
    {
      "start": 445.36,
      "end": 446.96,
      "text": "显示效果微调"
    },
    {
      "start": 446.96,
      "end": 447.96,
      "text": "我们点开它"
    },
    {
      "start": 447.96,
      "end": 448.6,
      "text": "在这里"
    },
    {
      "start": 448.6,
      "end": 449.4,
      "text": "你可以看到"
    },
    {
      "start": 449.4,
      "end": 452.68,
      "text": "在不同的亮度的情况下"
    },
    {
      "start": 452.68,
      "end": 453.28,
      "text": "这个位置"
    },
    {
      "start": 453.28,
      "end": 457.06,
      "text": "看到了吗"
    },
    {
      "start": 457.06,
      "end": 459.3,
      "text": "这次应该也是"
    },
    {
      "start": 459.3,
      "end": 460.78,
      "text": "中兴在这台机器上"
    },
    {
      "start": 460.78,
      "end": 462.5,
      "text": "引入了一套全新的技术"
    },
    {
      "start": 462.5,
      "end": 465.22,
      "text": "以前我们说的所谓的屏幕控光"
    },
    {
      "start": 465.22,
      "end": 466.66,
      "text": "是一套控制"
    },
    {
      "start": 466.66,
      "end": 469.22,
      "text": "针对多个像素点来进行控制"
    },
    {
      "start": 469.22,
      "end": 471.74,
      "text": "这台机器是单个像素点控制"
    },
    {
      "start": 471.74,
      "end": 474.86,
      "text": "它可以精细到摄像头的像素的位置"
    },
    {
      "start": 474.86,
      "end": 476.3,
      "text": "你可以让这个位置"
    },
    {
      "start": 476.3,
      "end": 478.78,
      "text": "显示你想要的效果"
    },
    {
      "start": 478.78,
      "end": 480.06,
      "text": "你没想挖孔"
    },
    {
      "start": 480.06,
      "end": 481.82,
      "text": "我也可以挖孔"
    },
    {
      "start": 481.82,
      "end": 482.3,
      "text": "虽然这么说"
    },
    {
      "start": 482.3,
      "end": 483.18,
      "text": "有点反尔赛"
    },
    {
      "start": 483.18,
      "end": 485.94,
      "text": "甚至可以针对单一的像素去调节"
    },
    {
      "start": 485.94,
      "end": 486.94,
      "text": "它的颜色"
    },
    {
      "start": 486.94,
      "end": 488.06,
      "text": "我这不光挖孔"
    },
    {
      "start": 488.06,
      "end": 489.54,
      "text": "我还能挖成绿孔"
    },
    {
      "start": 489.54,
      "end": 492.02,
      "text": "我还能挖成蓝孔"
    },
    {
      "start": 492.02,
      "end": 492.34,
      "text": "行吧"
    },
    {
      "start": 492.34,
      "end": 493.58,
      "text": "这些小心思"
    },
    {
      "start": 493.58,
      "end": 494.62,
      "text": "还是很好玩的"
    },
    {
      "start": 494.62,
      "end": 495.58,
      "text": "当然如果是我的"
    },
    {
      "start": 495.58,
      "end": 496.3,
      "text": "没什么说的"
    },
    {
      "start": 496.3,
      "end": 498.82,
      "text": "我就是没挖孔"
    },
    {
      "start": 498.82,
      "end": 499.62,
      "text": "刚才我看到"
    },
    {
      "start": 499.62,
      "end": 501.34,
      "text": "有很多同学弹幕想聊到说"
    },
    {
      "start": 501.34,
      "end": 502.78,
      "text": "能不能看一下"
    },
    {
      "start": 502.78,
      "end": 505.66,
      "text": "它显示这个位置的屏幕排列"
    },
    {
      "start": 505.66,
      "end": 506.46,
      "text": "是什么样子"
    },
    {
      "start": 506.46,
      "end": 507.06,
      "text": "没问题"
    },
    {
      "start": 507.06,
      "end": 508.1,
      "text": "咱们一起来看一看"
    },
    {
      "start": 508.1,
      "end": 508.78,
      "text": "首先"
    },
    {
      "start": 508.78,
      "end": 509.54,
      "text": "常规的部分"
    },
    {
      "start": 509.54,
      "end": 510.58,
      "text": "咱们已经看过了"
    },
    {
      "start": 510.58,
      "end": 512.78,
      "text": "记住外观的排列"
    },
    {
      "start": 512.78,
      "end": 513.38,
      "text": "接下来"
    },
    {
      "start": 513.38,
      "end": 514.66,
      "text": "咱们为大家展示一下"
    },
    {
      "start": 514.66,
      "end": 516.78,
      "text": "屏下摄像头区域的排列"
    },
    {
      "start": 516.78,
      "end": 517.34,
      "text": "好"
    },
    {
      "start": 517.34,
      "end": 518.54,
      "text": "在这里你可以看到"
    },
    {
      "start": 518.54,
      "end": 520.02,
      "text": "还是类钻式排列"
    },
    {
      "start": 520.02,
      "end": 521.98,
      "text": "但是似乎和刚才的"
    },
    {
      "start": 521.98,
      "end": 523.74,
      "text": "稍微有一点差别"
    },
    {
      "start": 523.74,
      "end": 525.06,
      "text": "有什么差别呢"
    },
    {
      "start": 525.06,
      "end": 526.06,
      "text": "看不出来是吧"
    },
    {
      "start": 526.06,
      "end": 530.1,
      "text": "那我们不妨就把屏幕挖孔的区域"
    },
    {
      "start": 530.1,
      "end": 531.58,
      "text": "和屏幕显示的区域"
    },
    {
      "start": 531.58,
      "end": 532.38,
      "text": "放到一起"
    },
    {
      "start": 532.38,
      "end": 533.78,
      "text": "来拍一张照片试试"
    },
    {
      "start": 533.78,
      "end": 534.62,
      "text": "这个有点困难"
    },
    {
      "start": 534.62,
      "end": 536.98,
      "text": "因为它区域非常的小"
    },
    {
      "start": 536.98,
      "end": 538.98,
      "text": "我尝试着找一找"
    },
    {
      "start": 538.98,
      "end": 539.26,
      "text": "好"
    },
    {
      "start": 539.26,
      "end": 540.74,
      "text": "不知道这样行不行"
    },
    {
      "start": 540.74,
      "end": 541.22,
      "text": "OK"
    },
    {
      "start": 541.22,
      "end": 542.26,
      "text": "来同学们"
    },
    {
      "start": 542.26,
      "end": 544.74,
      "text": "咱们下面一起来见证的就是"
    },
    {
      "start": 544.74,
      "end": 546.9,
      "text": "在这一个屏幕上面"
    },
    {
      "start": 546.9,
      "end": 549.46,
      "text": "你可以看到两种像素排列"
    },
    {
      "start": 549.46,
      "end": 552.78,
      "text": "下方的蓝色紫像素是类似方形的"
    },
    {
      "start": 552.78,
      "end": 555.86,
      "text": "上方的蓝色紫像素是类似圆形的"
    },
    {
      "start": 555.86,
      "end": 557.14,
      "text": "只有在显微镜下"
    },
    {
      "start": 557.14,
      "end": 560.02,
      "text": "我们才能看出如此的差别"
    },
    {
      "start": 560.02,
      "end": 562.14,
      "text": "但是这个差别已经非常的小了"
    },
    {
      "start": 562.14,
      "end": 564.54,
      "text": "也就是说我们肉眼去观看这个屏幕的时候"
    },
    {
      "start": 564.54,
      "end": 565.94,
      "text": "几乎已经看不出差别了"
    },
    {
      "start": 565.94,
      "end": 567.58,
      "text": "可以说全新升级的"
    },
    {
      "start": 567.58,
      "end": 570.58,
      "text": "Exon 40 Ultra的屏幕部分的表现"
    },
    {
      "start": 570.58,
      "end": 576.62,
      "text": "是超出我们的预期的"
    },
    {
      "start": 576.62,
      "end": 578.58,
      "text": "那是对称的扬声器"
    }
  ]
}
