{
  "film": "Trapped (1949)",
  "source": "input/source.mp4",
  "segments": [
    {
      "id": "n01",
      "kind": "narration",
      "output_start_s": 0.0,
      "output_end_s": 9.0,
      "source_start_s": 293.0,
      "source_end_s": 302.0,
      "duration_s": 9.0,
      "narration_zh": "餐馆老板收下一张二十美元假钞，只记得付款人是个留小胡子的年轻人。钞票随即被送交财政部。",
      "tts_speed": 1.0
    },
    {
      "id": "n02",
      "kind": "narration",
      "output_start_s": 9.0,
      "output_end_s": 18.0,
      "source_start_s": 366.0,
      "source_end_s": 375.0,
      "duration_s": 9.0,
      "narration_zh": "财政部实验室认出，这是斯图尔特母版沉寂三年后重新开印的假钞，连油墨和线条都旧得熟悉。",
      "tts_speed": 1.0251
    },
    {
      "id": "n03",
      "kind": "narration",
      "output_start_s": 18.0,
      "output_end_s": 27.0,
      "source_start_s": 389.0,
      "source_end_s": 398.0,
      "duration_s": 9.0,
      "narration_zh": "同版伪钞已在旧金山、里诺、拉斯维加斯和洛杉矶同时出现，财政部决定重启旧案。",
      "tts_speed": 1.0
    },
    {
      "id": "n04",
      "kind": "narration",
      "output_start_s": 27.0,
      "output_end_s": 36.0,
      "source_start_s": 437.0,
      "source_end_s": 446.0,
      "duration_s": 9.0,
      "narration_zh": "正在亚特兰大服刑的斯图尔特被带进办公室；他表现良好，却还背着七年刑期。",
      "tts_speed": 1.0
    },
    {
      "id": "n05",
      "kind": "narration",
      "output_start_s": 36.0,
      "output_end_s": 45.0,
      "source_start_s": 466.0,
      "source_end_s": 475.0,
      "duration_s": 9.0,
      "narration_zh": "探员把一张同版假钞推到他面前：当年他身上有五万美元，如今消失的母版显然又开印了。",
      "tts_speed": 1.0
    },
    {
      "id": "n06",
      "kind": "narration",
      "output_start_s": 45.0,
      "output_end_s": 54.0,
      "source_start_s": 499.0,
      "source_end_s": 508.0,
      "duration_s": 9.0,
      "narration_zh": "雷蒙德开出条件：合作可换减刑和假释；斯图尔特只交代一个戴墨镜、压低帽檐的接头人“乔”。",
      "tts_speed": 1.0
    },
    {
      "id": "n07",
      "kind": "narration",
      "output_start_s": 54.0,
      "output_end_s": 63.0,
      "source_start_s": 519.0,
      "source_end_s": 528.0,
      "duration_s": 9.0,
      "narration_zh": "减刑、假释、七年刑期，全压在一句旧名字上；斯图尔特没有立刻松口。",
      "tts_speed": 1.0
    },
    {
      "id": "o01",
      "kind": "original",
      "output_start_s": 63.0,
      "output_end_s": 70.0,
      "source_start_s": 528.3,
      "source_end_s": 535.3,
      "duration_s": 7.0,
      "original_en": [
        "Stool pigeons don't live long, Mr. Raymond.",
        "I don't expect you to be a stool pigeon. I'm asking you to be loyal to yourself."
      ],
      "subtitle_zh": [
        "斯图尔特：告密者活不长，雷蒙德先生。",
        "雷蒙德：我不是让你去告密，是让你替自己想。"
      ]
    },
    {
      "id": "n09",
      "kind": "narration",
      "output_start_s": 70.0,
      "output_end_s": 79.0,
      "source_start_s": 606.0,
      "source_end_s": 615.0,
      "duration_s": 9.0,
      "narration_zh": "几周后，联邦法院下令把他转往堪萨斯城；随行的副法警，其实是特勤局探员福尔曼。",
      "tts_speed": 1.0
    },
    {
      "id": "n10",
      "kind": "narration",
      "output_start_s": 79.0,
      "output_end_s": 88.0,
      "source_start_s": 688.0,
      "source_end_s": 697.0,
      "duration_s": 9.0,
      "narration_zh": "荒路上，押运车被拦停；车门、枪口和呵斥一齐压上来，一场“劫囚”演得煞有介事。",
      "tts_speed": 1.0
    },
    {
      "id": "n11",
      "kind": "narration",
      "output_start_s": 88.0,
      "output_end_s": 97.0,
      "source_start_s": 760.0,
      "source_end_s": 769.0,
      "duration_s": 9.0,
      "narration_zh": "接应车驶离现场；福尔曼摊牌，这是财政部安排的假越狱，斯图尔特必须替他们钓出印版。",
      "tts_speed": 1.0
    },
    {
      "id": "n12",
      "kind": "narration",
      "output_start_s": 97.0,
      "output_end_s": 106.0,
      "source_start_s": 803.0,
      "source_end_s": 812.0,
      "duration_s": 9.0,
      "narration_zh": "条件很清楚：斯图尔特帮忙找人和母版，财政部替他争假释，两人暂时必须寸步不离。",
      "tts_speed": 1.0
    },
    {
      "id": "n13",
      "kind": "narration",
      "output_start_s": 106.0,
      "output_end_s": 115.0,
      "source_start_s": 833.0,
      "source_end_s": 842.0,
      "duration_s": 9.0,
      "narration_zh": "公路在车窗外飞退，两个互相提防的人开始了同一场追猎，谁也不敢先露出底牌。",
      "tts_speed": 1.0
    },
    {
      "id": "n14",
      "kind": "narration",
      "output_start_s": 115.0,
      "output_end_s": 124.0,
      "source_start_s": 879.0,
      "source_end_s": 888.0,
      "duration_s": 9.0,
      "narration_zh": "旅馆里，斯图尔特借口划破手，趁福尔曼转身查看时突然出手，试图真正甩掉这条尾巴。",
      "tts_speed": 1.0
    },
    {
      "id": "n15",
      "kind": "narration",
      "output_start_s": 124.0,
      "output_end_s": 133.0,
      "source_start_s": 920.0,
      "source_end_s": 929.0,
      "duration_s": 9.0,
      "narration_zh": "两人扭打成一团；福尔曼奉命收力，好让这场脱逃看起来足够真实，又不能跟丢斯图尔特。",
      "tts_speed": 1.0731
    },
    {
      "id": "n16",
      "kind": "narration",
      "output_start_s": 133.0,
      "output_end_s": 142.0,
      "source_start_s": 960.0,
      "source_end_s": 969.0,
      "duration_s": 9.0,
      "narration_zh": "斯图尔特穿好外套独自离开，福尔曼仍远远缀在后面；两人都知道，下一站可能是洛杉矶。",
      "tts_speed": 1.0
    },
    {
      "id": "n17",
      "kind": "narration",
      "output_start_s": 142.0,
      "output_end_s": 151.0,
      "source_start_s": 978.0,
      "source_end_s": 987.0,
      "duration_s": 9.0,
      "narration_zh": "洛杉矶夜总会的卖烟女郎洛莉·弗雷德里克斯，就是改名后的梅格·狄克逊。",
      "tts_speed": 1.0
    },
    {
      "id": "n18",
      "kind": "narration",
      "output_start_s": 151.0,
      "output_end_s": 160.0,
      "source_start_s": 1003.0,
      "source_end_s": 1012.0,
      "duration_s": 9.0,
      "narration_zh": "常客哈克特掏出大额钞票买烟，连找零都嫌累赘；斯图尔特记住了这个出手反常的阔客。",
      "tts_speed": 1.0
    },
    {
      "id": "n19",
      "kind": "narration",
      "output_start_s": 160.0,
      "output_end_s": 169.0,
      "source_start_s": 1065.0,
      "source_end_s": 1074.0,
      "duration_s": 9.0,
      "narration_zh": "后门重逢时，梅格又惊又怕；她嘴上担心，最后还是把斯图尔特带回自己的公寓。",
      "tts_speed": 1.0
    },
    {
      "id": "n20",
      "kind": "narration",
      "output_start_s": 169.0,
      "output_end_s": 178.0,
      "source_start_s": 1141.0,
      "source_end_s": 1150.0,
      "duration_s": 9.0,
      "narration_zh": "旧情迅速复燃；斯图尔特没有抽身，反而把梅格卷进抢保险箱、筹钱买假钞的计划。",
      "tts_speed": 1.0
    },
    {
      "id": "o02",
      "kind": "original",
      "output_start_s": 178.0,
      "output_end_s": 189.4,
      "source_start_s": 1169.0,
      "source_end_s": 1180.4,
      "duration_s": 11.4,
      "original_en": [
        "I'm out of a prayer.",
        "The feds tagged me for a stool pigeon.",
        "They even sprung me, the dopes.",
        "Then I sprung one of them."
      ],
      "subtitle_zh": [
        "斯图尔特：我走投无路了。联邦探员想拿我当告密诱饵，",
        "还把我放出来，这帮蠢货。后来我甩掉了其中一个。"
      ]
    },
    {
      "id": "n22",
      "kind": "narration",
      "output_start_s": 189.4,
      "output_end_s": 198.4,
      "source_start_s": 1204.0,
      "source_end_s": 1213.0,
      "duration_s": 9.0,
      "narration_zh": "斯图尔特说，先找老搭档萨姆·胡克拿回印版，再带梅格远走墨西哥，从此不再回头。",
      "tts_speed": 1.0
    },
    {
      "id": "n23",
      "kind": "narration",
      "output_start_s": 198.4,
      "output_end_s": 207.4,
      "source_start_s": 1275.0,
      "source_end_s": 1284.0,
      "duration_s": 9.0,
      "narration_zh": "财政部同步掌握他的行踪，催福尔曼继续跟；夜总会里的哈克特，则是他们布下的另一枚棋子。",
      "tts_speed": 1.0
    },
    {
      "id": "n23b",
      "kind": "narration",
      "output_start_s": 207.4,
      "output_end_s": 216.4,
      "source_start_s": 1346.0,
      "source_end_s": 1355.0,
      "duration_s": 9.0,
      "narration_zh": "所谓“哈克特”真名约翰·道尼，是财政部特勤局卧底；洛莉和俱乐部都只当他是危险阔客。",
      "tts_speed": 1.0
    },
    {
      "id": "n24",
      "kind": "narration",
      "output_start_s": 216.4,
      "output_end_s": 225.4,
      "source_start_s": 1417.0,
      "source_end_s": 1426.0,
      "duration_s": 9.0,
      "narration_zh": "胡克缩在小酒吧里，斯图尔特带着三年牢狱的旧账闯上门，开口就问印版和当年的赃款。",
      "tts_speed": 1.0
    },
    {
      "id": "n25",
      "kind": "narration",
      "output_start_s": 225.4,
      "output_end_s": 234.4,
      "source_start_s": 1518.0,
      "source_end_s": 1527.0,
      "duration_s": 9.0,
      "narration_zh": "胡克承认把母版卖了，钱也赌光了；斯图尔特把他按在桌上，逼他交出买家的名字。",
      "tts_speed": 1.0
    },
    {
      "id": "n26",
      "kind": "narration",
      "output_start_s": 234.4,
      "output_end_s": 243.4,
      "source_start_s": 1558.0,
      "source_end_s": 1567.0,
      "duration_s": 9.0,
      "narration_zh": "名字卡在胡克喉咙里，他还在躲闪；斯图尔特的耐心已经见底，拳头随时会再落下。",
      "tts_speed": 1.0
    },
    {
      "id": "o03",
      "kind": "original",
      "output_start_s": 243.4,
      "output_end_s": 252.8,
      "source_start_s": 1573.6,
      "source_end_s": 1583.0,
      "duration_s": 9.4,
      "original_en": [
        "Does his name come to you now, huh?",
        "Sylvester. Jack Sylvester."
      ],
      "subtitle_zh": [
        "斯图尔特：现在名字想起来了吗？",
        "胡克：西尔维斯特。杰克·西尔维斯特。"
      ]
    },
    {
      "id": "n28",
      "kind": "narration",
      "output_start_s": 252.8,
      "output_end_s": 261.8,
      "source_start_s": 1622.0,
      "source_end_s": 1631.0,
      "duration_s": 9.0,
      "narration_zh": "招牌给出答案：格兰特大厦六九一二号，柑橘地产与投资公司，老板正是杰克·西尔维斯特。",
      "tts_speed": 1.0
    },
    {
      "id": "n29",
      "kind": "narration",
      "output_start_s": 261.8,
      "output_end_s": 270.8,
      "source_start_s": 1682.0,
      "source_end_s": 1691.0,
      "duration_s": 9.0,
      "narration_zh": "柑橘生意只是门面；西尔维斯特仍靠伪钞赚钱，对这个突然归来的旧伙伴半信半疑。",
      "tts_speed": 1.0
    },
    {
      "id": "n30",
      "kind": "narration",
      "output_start_s": 270.8,
      "output_end_s": 279.8,
      "source_start_s": 1726.0,
      "source_end_s": 1735.0,
      "duration_s": 9.0,
      "narration_zh": "他开出条件：至少两万五千美元现金，才肯卖一批仿真度极高、足以混过银行的假钞。",
      "tts_speed": 1.0
    },
    {
      "id": "n31",
      "kind": "narration",
      "output_start_s": 279.8,
      "output_end_s": 288.8,
      "source_start_s": 1802.0,
      "source_end_s": 1811.0,
      "duration_s": 9.0,
      "narration_zh": "斯图尔特拿不出本钱，便把主意打到梅格工作的夜总会保险箱上，想用一笔抢案填上缺口。",
      "tts_speed": 1.0
    },
    {
      "id": "n32",
      "kind": "narration",
      "output_start_s": 288.8,
      "output_end_s": 297.8,
      "source_start_s": 1918.0,
      "source_end_s": 1927.0,
      "duration_s": 9.0,
      "narration_zh": "两人的密谈已被财政部听见；探员决定让巡警盯住梅格，免得抢案毁掉刚接上的卧底线索。",
      "tts_speed": 1.0
    },
    {
      "id": "n33",
      "kind": "narration",
      "output_start_s": 297.8,
      "output_end_s": 306.8,
      "source_start_s": 1937.0,
      "source_end_s": 1946.0,
      "duration_s": 9.0,
      "narration_zh": "探员担心，这笔抢案若让斯图尔特被杀或被捕，刚有起色的卧底线就会彻底断掉。",
      "tts_speed": 1.0
    },
    {
      "id": "n34",
      "kind": "narration",
      "output_start_s": 306.8,
      "output_end_s": 315.8,
      "source_start_s": 2040.0,
      "source_end_s": 2049.0,
      "duration_s": 9.0,
      "narration_zh": "巡警在夜总会外反复盘问梅格，故意拖住她，还追问刚离开车里的男人究竟是谁。",
      "tts_speed": 1.0
    },
    {
      "id": "n35",
      "kind": "narration",
      "output_start_s": 315.8,
      "output_end_s": 324.8,
      "source_start_s": 2088.0,
      "source_end_s": 2097.0,
      "duration_s": 9.0,
      "narration_zh": "道尼请律师、付保释金，把梅格领出警局，像个肯为她花钱、又摸得清门路的老朋友。",
      "tts_speed": 1.0
    },
    {
      "id": "n36",
      "kind": "narration",
      "output_start_s": 324.8,
      "output_end_s": 333.8,
      "source_start_s": 2120.0,
      "source_end_s": 2129.0,
      "duration_s": 9.0,
      "narration_zh": "他一边送她回去，一边套话；梅格只把这位阔客当成可利用的靠山，却不知他每句话都在设套。",
      "tts_speed": 1.0
    },
    {
      "id": "n37",
      "kind": "narration",
      "output_start_s": 333.8,
      "output_end_s": 342.8,
      "source_start_s": 2194.0,
      "source_end_s": 2203.0,
      "duration_s": 9.0,
      "narration_zh": "斯图尔特回来听说道尼垫了钱，立刻警觉：普通赌徒不该有这种门路，更不该总缠着梅格。",
      "tts_speed": 1.0
    },
    {
      "id": "n38",
      "kind": "narration",
      "output_start_s": 342.8,
      "output_end_s": 351.8,
      "source_start_s": 2300.0,
      "source_end_s": 2309.0,
      "duration_s": 9.0,
      "narration_zh": "他闯进玛格丽特酒店，先给道尼一拳，再趁对方不备翻查行李，寻找这个人的底牌。",
      "tts_speed": 1.0
    },
    {
      "id": "n39",
      "kind": "narration",
      "output_start_s": 351.8,
      "output_end_s": 360.8,
      "source_start_s": 2321.5,
      "source_end_s": 2330.5,
      "duration_s": 9.0,
      "narration_zh": "旧剪报、赌具和一张“别和这人打牌”的通报，拼出一个职业赌徒危险的底细。",
      "tts_speed": 1.0
    },
    {
      "id": "n40",
      "kind": "narration",
      "output_start_s": 360.8,
      "output_end_s": 369.8,
      "source_start_s": 2398.0,
      "source_end_s": 2407.0,
      "duration_s": 9.0,
      "narration_zh": "斯图尔特拔枪逼问梅格的事，又顺势改口，把一场寻仇变成向道尼兜售假钞生意。",
      "tts_speed": 1.0
    },
    {
      "id": "n41",
      "kind": "narration",
      "output_start_s": 369.8,
      "output_end_s": 378.8,
      "source_start_s": 2436.0,
      "source_end_s": 2445.0,
      "duration_s": 9.0,
      "narration_zh": "道尼答应拿出两万五千美元真钞，换回面值二十五万美元、几乎可以乱真的伪钞。",
      "tts_speed": 1.0
    },
    {
      "id": "o04",
      "kind": "original",
      "output_start_s": 378.8,
      "output_end_s": 386.8,
      "source_start_s": 2446.4,
      "source_end_s": 2454.4,
      "duration_s": 8.0,
      "original_en": [
        "If I had 25 Gs, I could stretch it to a quarter of a million.",
        "Don't interrupt. That quarter of a million's phony."
      ],
      "subtitle_zh": [
        "斯图尔特：有两万五千美元，我就能把它变成二十五万。",
        "哈克特：别插嘴，那二十五万是假钞。"
      ]
    },
    {
      "id": "n43",
      "kind": "narration",
      "output_start_s": 386.8,
      "output_end_s": 395.8,
      "source_start_s": 2492.0,
      "source_end_s": 2501.0,
      "duration_s": 9.0,
      "narration_zh": "斯图尔特自以为在试探对方，却不知道道尼等的正是这条通往母版的线，诱饵已被接住。",
      "tts_speed": 1.0
    },
    {
      "id": "n44",
      "kind": "narration",
      "output_start_s": 395.8,
      "output_end_s": 404.8,
      "source_start_s": 2508.0,
      "source_end_s": 2517.0,
      "duration_s": 9.0,
      "narration_zh": "西尔维斯特查阅“哈克特”的底细，看到的是财政部替他准备的一份完整犯罪履历。",
      "tts_speed": 1.0
    },
    {
      "id": "n45",
      "kind": "narration",
      "output_start_s": 404.8,
      "output_end_s": 413.8,
      "source_start_s": 2570.0,
      "source_end_s": 2579.0,
      "duration_s": 9.0,
      "narration_zh": "道尼故意把伪钞说成真钞，逼西尔维斯特拿出另一张真票，当场比对线条与边框。",
      "tts_speed": 1.0
    },
    {
      "id": "n46",
      "kind": "narration",
      "output_start_s": 413.8,
      "output_end_s": 422.8,
      "source_start_s": 2624.0,
      "source_end_s": 2633.0,
      "duration_s": 9.0,
      "narration_zh": "验货过关后，双方约在喷泉大道交货；财政部提前把整条街布成口袋，只等赃款露面。",
      "tts_speed": 1.0
    },
    {
      "id": "n47",
      "kind": "narration",
      "output_start_s": 422.8,
      "output_end_s": 431.8,
      "source_start_s": 2688.0,
      "source_end_s": 2697.0,
      "duration_s": 9.0,
      "narration_zh": "道尼随即向财政部汇报：正午，喷泉大道，双方会带钱和货碰头，他认为这次很像真的。",
      "tts_speed": 1.0
    },
    {
      "id": "n48",
      "kind": "narration",
      "output_start_s": 431.8,
      "output_end_s": 440.8,
      "source_start_s": 2734.0,
      "source_end_s": 2743.0,
      "duration_s": 9.0,
      "narration_zh": "他定下暗号：看到钱交到接货人手里，就把一只啤酒箱放上人行道，谁都不许提前动。",
      "tts_speed": 1.0
    },
    {
      "id": "n49",
      "kind": "narration",
      "output_start_s": 440.8,
      "output_end_s": 449.8,
      "source_start_s": 2753.0,
      "source_end_s": 2762.0,
      "duration_s": 9.0,
      "narration_zh": "箱子落地就是收网令；若谁抢跑一步，交易会散，卧底也可能当场丢命。",
      "tts_speed": 1.0
    },
    {
      "id": "n49b",
      "kind": "narration",
      "output_start_s": 449.8,
      "output_end_s": 458.8,
      "source_start_s": 2810.0,
      "source_end_s": 2819.0,
      "duration_s": 9.0,
      "narration_zh": "正午前，杂货店、修车摊和街口都埋伏着人，表面却一如往常，安静得只剩脚步声。",
      "tts_speed": 1.0
    },
    {
      "id": "n50",
      "kind": "narration",
      "output_start_s": 458.8,
      "output_end_s": 467.8,
      "source_start_s": 2944.5,
      "source_end_s": 2953.5,
      "duration_s": 9.0,
      "narration_zh": "接头时，斯图尔特打开的包裹里没有假钞，只有一叠裁碎的纸；他仍装作这就是货。",
      "tts_speed": 1.0
    },
    {
      "id": "n51",
      "kind": "narration",
      "output_start_s": 467.8,
      "output_end_s": 476.8,
      "source_start_s": 2953.5,
      "source_end_s": 2962.5,
      "duration_s": 9.0,
      "narration_zh": "对方当场翻脸，斯图尔特却承认这是试路——他要确认哈克特不是替警察设局的人。",
      "tts_speed": 1.0
    },
    {
      "id": "n52",
      "kind": "narration",
      "output_start_s": 476.8,
      "output_end_s": 485.8,
      "source_start_s": 3072.0,
      "source_end_s": 3081.0,
      "duration_s": 9.0,
      "narration_zh": "接头人接受解释，约定下一趟全是真货；双方都以为自己试探成功，鱼已经上钩。",
      "tts_speed": 1.0
    },
    {
      "id": "n53",
      "kind": "narration",
      "output_start_s": 485.8,
      "output_end_s": 494.8,
      "source_start_s": 3119.0,
      "source_end_s": 3128.0,
      "duration_s": 9.0,
      "narration_zh": "回到夜总会，一个醉客突然盯住道尼的脸，像认出了多年不见的熟人。",
      "tts_speed": 1.0
    },
    {
      "id": "o05",
      "kind": "original",
      "output_start_s": 494.8,
      "output_end_s": 502.3,
      "source_start_s": 3133.8,
      "source_end_s": 3141.3,
      "duration_s": 7.5,
      "original_en": [
        "Johnny. Johnny Downey. How you been, Johnny?",
        "I'm afraid you got the wrong party, pal.",
        "Oh, not a chance."
      ],
      "subtitle_zh": [
        "醉客：约翰尼，约翰尼·道尼，你最近怎么样？",
        "道尼：朋友，你认错人了。",
        "醉客：绝不可能。"
      ]
    },
    {
      "id": "n55",
      "kind": "narration",
      "output_start_s": 502.3,
      "output_end_s": 511.3,
      "source_start_s": 3180.0,
      "source_end_s": 3189.0,
      "duration_s": 9.0,
      "narration_zh": "梅格听见“约翰尼·道尼”这个名字，才意识到身边的阔客竟是联邦卧底。",
      "tts_speed": 1.0
    },
    {
      "id": "n56",
      "kind": "narration",
      "output_start_s": 511.3,
      "output_end_s": 520.3,
      "source_start_s": 3240.0,
      "source_end_s": 3249.0,
      "duration_s": 9.0,
      "narration_zh": "她把消息带回公寓，两人关灯、压低声音，翻查每一个可能藏东西的角落。",
      "tts_speed": 1.0
    },
    {
      "id": "n57",
      "kind": "narration",
      "output_start_s": 520.3,
      "output_end_s": 529.3,
      "source_start_s": 3294.0,
      "source_end_s": 3303.0,
      "duration_s": 9.0,
      "narration_zh": "一台窃听装置被搜出，他们此前每一句密谈，都早已送进财政部的耳朵。",
      "tts_speed": 1.0
    },
    {
      "id": "n58",
      "kind": "narration",
      "output_start_s": 529.3,
      "output_end_s": 538.3,
      "source_start_s": 3440.0,
      "source_end_s": 3449.0,
      "duration_s": 9.0,
      "narration_zh": "车里，斯图尔特突然摊牌：他早就看穿道尼的卧底身份，也决定不再替财政部做事。",
      "tts_speed": 1.0539
    },
    {
      "id": "n59",
      "kind": "narration",
      "output_start_s": 538.3,
      "output_end_s": 547.3,
      "source_start_s": 3472.0,
      "source_end_s": 3481.0,
      "duration_s": 9.0,
      "narration_zh": "他要抢下这笔钱，切断与财政部唯一的联系，再带梅格按原计划脱身。",
      "tts_speed": 1.0
    },
    {
      "id": "n60",
      "kind": "narration",
      "output_start_s": 547.3,
      "output_end_s": 556.3,
      "source_start_s": 3540.0,
      "source_end_s": 3549.0,
      "duration_s": 9.0,
      "narration_zh": "海崖边，两人扭打，斯图尔特最终把道尼打倒在地，准备带着钱离开。",
      "tts_speed": 1.0
    },
    {
      "id": "n61",
      "kind": "narration",
      "output_start_s": 556.3,
      "output_end_s": 565.3,
      "source_start_s": 3588.0,
      "source_end_s": 3597.0,
      "duration_s": 9.0,
      "narration_zh": "警车赶到，斯图尔特来不及抽身，就被当场制服逮捕；赃款也重新落到警方手里。",
      "tts_speed": 1.0
    },
    {
      "id": "n62",
      "kind": "narration",
      "output_start_s": 565.3,
      "output_end_s": 574.3,
      "source_start_s": 3604.0,
      "source_end_s": 3613.0,
      "duration_s": 9.0,
      "narration_zh": "道尼要求不登报，让他以“布里格斯”之名入案，免得匪帮循着消息先一步下手。",
      "tts_speed": 1.0
    },
    {
      "id": "n63",
      "kind": "narration",
      "output_start_s": 574.3,
      "output_end_s": 583.3,
      "source_start_s": 3686.0,
      "source_end_s": 3695.0,
      "duration_s": 9.0,
      "narration_zh": "财政部紧接着去抓梅格，公寓里却只剩空衣橱和匆匆带走行李的痕迹。",
      "tts_speed": 1.0
    },
    {
      "id": "n64",
      "kind": "narration",
      "output_start_s": 583.3,
      "output_end_s": 592.3,
      "source_start_s": 3716.0,
      "source_end_s": 3725.0,
      "duration_s": 9.0,
      "narration_zh": "西尔维斯特得知斯图尔特被捕，立刻下令清空据点，准备把机器和成品全部转走。",
      "tts_speed": 1.0
    },
    {
      "id": "n65",
      "kind": "narration",
      "output_start_s": 592.3,
      "output_end_s": 601.3,
      "source_start_s": 3860.0,
      "source_end_s": 3869.0,
      "duration_s": 9.0,
      "narration_zh": "道尼与西尔维斯特同车试探，后视镜里却多出一辆甩不掉的跟踪车，气氛骤然绷紧。",
      "tts_speed": 1.0
    },
    {
      "id": "n66",
      "kind": "narration",
      "output_start_s": 601.3,
      "output_end_s": 610.3,
      "source_start_s": 4000.0,
      "source_end_s": 4009.0,
      "duration_s": 9.0,
      "narration_zh": "梅格独自找到西尔维斯特，手下却把她带去电车车场；她已彻底落进匪帮手里。",
      "tts_speed": 1.0
    },
    {
      "id": "n67",
      "kind": "narration",
      "output_start_s": 610.3,
      "output_end_s": 619.3,
      "source_start_s": 4096.0,
      "source_end_s": 4105.0,
      "duration_s": 9.0,
      "narration_zh": "据点里，印刷机仍在转，成捆假钞、纸张和母版正被迅速装车，准备随时撤离。",
      "tts_speed": 1.0
    },
    {
      "id": "n68",
      "kind": "narration",
      "output_start_s": 619.3,
      "output_end_s": 628.3,
      "source_start_s": 4226.0,
      "source_end_s": 4235.0,
      "duration_s": 9.0,
      "narration_zh": "西尔维斯特拒绝出售母版，称它们是自己的养老金，印钞能力比现钱更值钱。",
      "tts_speed": 1.0
    },
    {
      "id": "n69",
      "kind": "narration",
      "output_start_s": 628.3,
      "output_end_s": 637.3,
      "source_start_s": 4285.0,
      "source_end_s": 4294.0,
      "duration_s": 9.0,
      "narration_zh": "梅格当面揭穿哈克特是警察，西尔维斯特这才明白，整场交易早被执法部门盯上。",
      "tts_speed": 1.0
    },
    {
      "id": "n70",
      "kind": "narration",
      "output_start_s": 637.3,
      "output_end_s": 646.3,
      "source_start_s": 4348.0,
      "source_end_s": 4357.0,
      "duration_s": 9.0,
      "narration_zh": "他扣住梅格，枪口指向道尼；双方都知道，车场外已经围满警察。",
      "tts_speed": 1.0
    },
    {
      "id": "n71",
      "kind": "narration",
      "output_start_s": 646.3,
      "output_end_s": 655.3,
      "source_start_s": 4650.0,
      "source_end_s": 4659.0,
      "duration_s": 9.0,
      "narration_zh": "特勤局和警方冲进车场，在电车轨道之间展开枪战，匪帮的退路被一段段封死。",
      "tts_speed": 1.0
    },
    {
      "id": "n72",
      "kind": "narration",
      "output_start_s": 655.3,
      "output_end_s": 664.3,
      "source_start_s": 4659.0,
      "source_end_s": 4668.0,
      "duration_s": 9.0,
      "narration_zh": "西尔维斯特边打边退，最终从高架跌落，再无退路；警方的包围随即收紧。",
      "tts_speed": 1.0
    },
    {
      "id": "n73",
      "kind": "narration",
      "output_start_s": 664.3,
      "output_end_s": 673.3,
      "source_start_s": 4668.0,
      "source_end_s": 4677.0,
      "duration_s": 9.0,
      "narration_zh": "枪声停下，匪帮被逐一制服，成捆伪钞和印版都留在车场，没有一件被带走。",
      "tts_speed": 1.0
    },
    {
      "id": "n74",
      "kind": "narration",
      "output_start_s": 673.3,
      "output_end_s": 683.3,
      "source_start_s": 4696.0,
      "source_end_s": 4706.0,
      "duration_s": 10.0,
      "narration_zh": "案后清点出二十四万零二十美元伪钞、母版和证据清单，随后封箱送往华盛顿。",
      "tts_speed": 1.0
    },
    {
      "id": "o06",
      "kind": "original",
      "output_start_s": 683.3,
      "output_end_s": 688.5,
      "source_start_s": 4718.8,
      "source_end_s": 4724.0,
      "duration_s": 5.2,
      "original_en": [
        "Well, I guess that closes the Stewart case."
      ],
      "subtitle_zh": [
        "探员：看来，斯图尔特案到此结束了。"
      ]
    },
    {
      "id": "n76",
      "kind": "narration",
      "output_start_s": 688.5,
      "output_end_s": 696.5,
      "source_start_s": 4724.0,
      "source_end_s": 4732.0,
      "duration_s": 8.0,
      "narration_zh": "旧版伪钞的源头，到这里才真正拔除；斯图尔特案也随之落幕。",
      "tts_speed": 1.0
    }
  ]
}
